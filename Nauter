-- KEYBIND
function TabMethods:CreateKeybind(config)
    config = config or {}

    local Tab = self
    local Callback = config.Callback or function() end
    local CurrentKey = config.CurrentKey or config.Default or Enum.KeyCode.RightShift
    local Listening = false

    local Container = CreateContainer(
        Tab,
        config.Name or "Keybind",
        42
    )

    local Title = AddText(
        Container,
        tostring(config.Name or "Keybind"),
        12,
        Theme.Text,
        Enum.Font.GothamMedium
    )

    Title.Position = UDim2.new(0, 10, 0, 0)
    Title.Size = UDim2.new(1, -115, 1, 0)

    local KeyButton = Create("TextButton", {
        Name = "KeyButton",
        AnchorPoint = Vector2.new(1, 0.5),
        Position = UDim2.new(1, -8, 0.5, 0),
        Size = UDim2.fromOffset(100, 27),
        BackgroundColor3 = Theme.Background,
        BorderSizePixel = 0,
        AutoButtonColor = false,
        Text = CurrentKey.Name,
        TextColor3 = Theme.Purple,
        TextSize = 11,
        Font = Enum.Font.GothamBold
    }, Container)

    AddCorner(KeyButton, 7)
    AddStroke(KeyButton, Theme.Border, 1, 0.5)

    local function UpdateKeyText()
        if typeof(CurrentKey) == "EnumItem" then
            KeyButton.Text = CurrentKey.Name
        else
            KeyButton.Text = tostring(CurrentKey)
        end
    end

    local function FireCallback(Input)
        local Success, ErrorMessage = pcall(
            Callback,
            Input,
            CurrentKey
        )

        if not Success then
            warn("[Nauter Keybind Error]:", ErrorMessage)
        end
    end

    KeyButton.Activated:Connect(function()
        if Tab.Window.IsDestroyed then
            return
        end

        Listening = true
        KeyButton.Text = "Press a key..."
        KeyButton.TextColor3 = Theme.White
    end)

    local KeyConnection = UserInputService.InputBegan:Connect(function(Input, Processed)
        if Tab.Window.IsDestroyed then
            return
        end

        if Listening then
            if Input.UserInputType ~= Enum.UserInputType.Keyboard then
                return
            end

            CurrentKey = Input.KeyCode
            Listening = false
            UpdateKeyText()
            KeyButton.TextColor3 = Theme.Purple
            return
        end

        if Processed then
            return
        end

        if Input.UserInputType == Enum.UserInputType.Keyboard
            and Input.KeyCode == CurrentKey then

            FireCallback(Input)
        end
    end)

    table.insert(Tab.Window.Connections, KeyConnection)

    return {
        Instance = Container,
        Button = KeyButton,

        Set = function(_, NewKey)
            if typeof(NewKey) == "EnumItem" then
                CurrentKey = NewKey
                Listening = false
                UpdateKeyText()
            end
        end,

        Get = function()
            return CurrentKey
        end
    }
end

