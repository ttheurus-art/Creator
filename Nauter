local function Card(tab, height)
    local obj = Make("Frame", {
        Size = UDim2.new(1, -4, 0, height),
        BackgroundColor3 = C.Panel,
        BackgroundTransparency = 0.05,
        BorderSizePixel = 0
    }, tab.Page)

    Round(obj, 9)
