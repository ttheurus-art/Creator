-- NOTIFICATION WITH SHRINKING TIMER

function Nauter:Notify(data)
    data = data or {}

    local duration = math.max(
        tonumber(data.Duration) or 3, 0.5
    )

    local toast = Make("Frame", {
        AnchorPoint = Vector2.new(1, 0),
        Position = UDim2.new(1, -12, 0, 12),
        Size = UDim2.new(0.65, 0, 0, 76),
        BackgroundColor3 = C.Panel,
        BackgroundTransparency = 0.05,
        BorderSizePixel = 0,
        ZIndex = 20
    }, Gui)

    Round(toast, 11)
    Stroke(toast, C.Purple, 0.2, 1.2)

    local t = Label(
        toast, data.Title or "Nauter", 25, C.Neon
    )
    t.Position = UDim2.new(0, 10, 0, 5)
    t.Size = UDim2.new(1, -20, 0, 25)
    t.Font = Enum.Font.GothamBold
    t.ZIndex = 21

    local msg = Label(
        toast, data.Content or "", 34, C.White
    )
    msg.Position = UDim2.new(0, 10, 0, 30)
    msg.Size = UDim2.new(1, -20, 0, 34)
    msg.ZIndex = 21

    -- TIMER TRACK

    local track = Make("Frame", {
        Position = UDim2.new(0, 10, 1, -7),
        Size = UDim2.new(1, -20, 0, 3),
        BackgroundColor3 = C.Off,
        BorderSizePixel = 0,
        ZIndex = 22
    }, toast)

    Round(track, 4)

    -- Shrinks from RIGHT to LEFT.

    local timerLine = Make("Frame", {
        AnchorPoint = Vector2.new(1, 0),
        Position = UDim2.new(1, 0, 0, 0),
        Size = UDim2.new(1, 0, 1, 0),
        BackgroundColor3 = C.Neon,
        BorderSizePixel = 0,
        ZIndex = 23
    }, track)

    Round(timerLine, 4)

    TweenService:Create(
        timerLine,
        TweenInfo.new(duration, Enum.EasingStyle.Linear),
        {Size = UDim2.new(0, 0, 1, 0)}
    ):Play()

    task.delay(duration, function()
        if not toast.Parent then return end

        local fade = TweenInfo.new(0.18)

        TweenService:Create(toast, fade, {
            BackgroundTransparency = 1
        }):Play()

        for _, obj in ipairs(toast:GetDescendants()) do
            if obj:IsA("TextLabel") then
                TweenService:Create(obj, fade, {
                    TextTransparency = 1
                }):Play()
            elseif obj:IsA("UIStroke") then
                TweenService:Create(obj, fade, {
                    Transparency = 1
                }):Play()
            elseif obj:IsA("Frame") then
                TweenService:Create(obj, fade, {
                    BackgroundTransparency = 1
                }):Play()
            end
        end

        task.wait(0.2)

        if toast.Parent then
            toast:Destroy()
        end
    end)

    return toast
end

