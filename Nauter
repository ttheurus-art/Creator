-- SLIDER

local function AddSlider(page, name, min, max, default, callback)
    min = tonumber(min) or 0
    max = tonumber(max) or 100
    if max <= min then max = min + 1 end

    local value = math.clamp(tonumber(default) or min, min, max)
    local box = AddCard(page, 66)

    local label = Label(box, name .. ": " .. value, 24)
    label.Position = UDim2.new(0, 10, 0, 4)
    label.Size = UDim2.new(1, -20, 0, 24)

    local bar = Make("Frame", {
        Position = UDim2.new(0, 10, 0, 43),
        Size = UDim2.new(1, -20, 0, 6),
        BackgroundColor3 = C.Off,
        BorderSizePixel = 0
    }, box)
    Round(bar, 8)

    local fill = Make("Frame", {
        Size = UDim2.new((value - min) / (max - min), 0, 1, 0),
        BackgroundColor3 = C.Purple,
        BorderSizePixel = 0
    }, bar)
    Round(fill, 8)

    local hit = Make("TextButton", {
        Position = UDim2.new(0, 0, 0, 28),
        Size = UDim2.new(1, 0, 0, 35),
        BackgroundTransparency = 1,
        Text = "",
        BorderSizePixel = 0
    }, box)

    local function Set(x)
        local width = bar.AbsoluteSize.X
        if width <= 0 then return end

        value = math.floor(min + math.clamp(
            (x - bar.AbsolutePosition.X) / width, 0, 1
        ) * (max - min) + 0.5)

        fill.Size = UDim2.new((value - min) / (max - min), 0, 1, 0)
        label.Text = name .. ": " .. value

        if callback then callback(value) end
    end

    local active = false

    hit.InputBegan:Connect(function(input)
        if input.UserInputType == Enum.UserInputType.MouseButton1
        or input.UserInputType == Enum.UserInputType.Touch then
            active = true
            Set(input.Position.X)
        end
    end)

    local changedConnection = UIS.InputChanged:Connect(function(input)
        if not active then return end

        if input.UserInputType == Enum.UserInputType.MouseMovement
        or input.UserInputType == Enum.UserInputType.Touch then
            Set(input.Position.X)
        end
    end)

    local endedConnection = UIS.InputEnded:Connect(function(input)
        if input.UserInputType == Enum.UserInputType.MouseButton1
        or input.UserInputType == Enum.UserInputType.Touch then
            active = false
        end
    end)

    box.Destroying:Connect(function()
        changedConnection:Disconnect()
        endedConnection:Disconnect()
    end)

    return box
end

