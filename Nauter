function TabMethods:CreateDropdown(config)
    config = config or {}

    local Options = config.Options or {}
    local Multiple = config.MultipleOptions == true
    local Selected = {}

    local Default = config.CurrentOption or config.Default

    if typeof(Default) == "table" then
        for _, Option in ipairs(Default) do
            Selected[Option] = true
        end
    elseif Default ~= nil then
        Selected[Default] = true
    end

    local Container = CreateContainer(
        self,
