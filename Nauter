-- DROPDOWN

function TabAPI:CreateDropdown(Config)
    Config = Config or {}

    local Options = Config.Options or {}
    local Selected = Config.CurrentOption

    if type(Selected) == "table" then
        Selected = Selected[1]
    end

    local Multi = Config.MultipleOptions == true
    local Open = false

    local Container = CreateContainer(44)

    local Button = Make("TextButton", {
        Size = UDim2.new(1, -8, 1, -8),
        Position = UDim2.new(0, 4, 0, 4),
        BackgroundColor3 = C.BG,
        BorderSizePixel = 0,
        Text = "",
        AutoButtonColor = false
    }, Container)
    Round(Button, 7)

    local Name = Make("TextLabel", {
        Position = UDim2.new(0, 9, 0, 0),
        Size = UDim2.new(0.48, 0, 1, 0),
        BackgroundTransparency = 1,
        Text = Config.Name or "Dropdown",
        TextColor3 = C.White,
        TextSize = 11,
        Font = Enum.Font.Gotham,
        TextXAlignment = Enum.TextXAlignment.Left
    }, Button)

    local SelectedLabel = Make("TextLabel", {
        Position = UDim2.new(0.45, 0, 0, 0),
        Size = UDim2.new(0.45, -8, 1, 0),
        BackgroundTransparency = 1,
        Text = tostring(Selected or "Select..."),
        TextColor3 = C.Neon,
        TextSize = 10,
        Font = Enum.Font.Gotham,
        TextXAlignment = Enum.TextXAlignment.Right,
        TextTruncate = Enum.TextTruncate.AtEnd
    }, Button)

    local Arrow = Make("TextLabel", {
        Position = UDim2.new(1, -23, 0, 0),
        Size = UDim2.new(0, 18, 1, 0),
        BackgroundTransparency = 1,
        Text = "v",
        TextColor3 = C.Neon,
        TextSize = 12,
        Font = Enum.Font.GothamBold
    }, Button)

    local List = Make("ScrollingFrame", {
        Position = UDim2.new(0, 0, 1, 4),
        Size = UDim2.new(1, 0, 0, 0),
        BackgroundColor3 = C.Panel,
        BorderSizePixel = 0,
        ScrollBarThickness = 3,
        ScrollBarImageColor3 = C.Purple,
        CanvasSize = UDim2.new(),
        AutomaticCanvasSize = Enum.AutomaticSize.Y,
        Visible = false,
        ZIndex = 20
    }, Container)
    Round(List, 7)
    Stroke(List, C.Purple, 0.15, 1)

    Make("UIListLayout", {
        Padding = UDim.new(0, 3),
        SortOrder = Enum.SortOrder.LayoutOrder
    }, List)

    Make("UIPadding", {
        PaddingTop = UDim.new(0, 4),
        PaddingBottom = UDim.new(0, 4),
        PaddingLeft = UDim.new(0, 4),
        PaddingRight = UDim.new(0, 4)
    }, List)

    local function RefreshSelected()
        if Multi then
            local Result = {}
            for Option, IsSelected in pairs(Selected or {}) do
                if IsSelected then
                    table.insert(Result, tostring(Option))
                end
            end
            table.sort(Result)
            SelectedLabel.Text = #Result > 0
                and table.concat(Result, ", ") or "Select..."
        else
            SelectedLabel.Text = tostring(Selected or "Select...")
        end
    end

    local function SetOpen(State)
        Open = State
        Arrow.Text = Open and "^" or "v"
        List.Visible = Open

        Container.Size = UDim2.new(
            1, 0, 0, Open and 44 + math.min(#Options * 31 + 8, 155) or 44
        )

        List.Size = UDim2.new(
            1, -8, 0, Open and math.min(#Options * 31 + 8, 155) or 0
        )
    end

    local function Rebuild()
        for _, Child in ipairs(List:GetChildren()) do
            if Child:IsA("TextButton") then
                Child:Destroy()
            end
        end

        for Index, Option in ipairs(Options) do
            local OptionButton = Make("TextButton", {
                Size = UDim2.new(1, 0, 0, 28),
                BackgroundColor3 = C.BG,
                BorderSizePixel = 0,
                Text = tostring(Option),
                TextColor3 = C.White,
                TextSize = 11,
                Font = Enum.Font.Gotham,
                LayoutOrder = Index,
                ZIndex = 21
            }, List)
            Round(OptionButton, 5)

            OptionButton.Activated:Connect(function()
                if Multi then
                    Selected = Selected or {}
                    Selected[Option] = not Selected[Option]
                else
                    Selected = Option
                    SetOpen(false)
                end

                RefreshSelected()

                if Config.Callback then
                    task.spawn(Config.Callback, Multi and Selected or Option)
                end
            end)
        end
    end

    Button.Activated:Connect(function()
        SetOpen(not Open)
    end)

    local API = {}

    function API:Set(NewOption)
        if Multi then
            Selected = {}
            if type(NewOption) == "table" then
                for _, Option in ipairs(NewOption) do
                    Selected[Option] = true
                end
            end
        else
            Selected = NewOption
        end

        RefreshSelected()
        if Config.Callback then
            task.spawn(Config.Callback, Selected)
        end
    end

    function API:Refresh(NewOptions)
        Options = NewOptions or {}
        Rebuild()
        SetOpen(false)
    end

    function API:Get()
        return Selected
    end

    Rebuild()
    RefreshSelected()
    return API
end

