local miniDragging, miniMoved = false, false
local miniStart, miniPos
local animating = false
local normalSize = Main.Size
local normalPosition = Main.Position

-- MINIMIZE

Min.Activated:Connect(function()
    if animating or not Main.Visible then return end
    animating = true

    normalSize = Main.Size
    normalPosition = Main.Position

    local tween = TweenService:Create(
        Main,
        TweenInfo.new(0.25, Enum.EasingStyle.Quad, Enum.EasingDirection.In),
        {
            Size = UDim2.fromOffset(1, 1),
            BackgroundTransparency = 1
        }
    )

    tween:Play()
    tween.Completed:Wait()

    Main.Visible = false
    Main.Size = normalSize
    Main.Position = normalPosition
    Main.BackgroundTransparency = 0.1

    MiniN.Visible = true
    animating = false
end)

-- OPEN

MiniN.Activated:Connect(function()
    if miniMoved then
        miniMoved = false
        return
    end

    if animating then return end
    animating = true

    MiniN.Visible = false
    Main.Size = UDim2.fromOffset(1, 1)
    Main.BackgroundTransparency = 1
    Main.Position = normalPosition
    Main.Visible = true

    local tween = TweenService:Create(
        Main,
        TweenInfo.new(0.3, Enum.EasingStyle.Back, Enum.EasingDirection.Out),
        {
            Size = normalSize,
            BackgroundTransparency = 0.1
        }
    )

    tween:Play()
    tween.Completed:Wait()

    animating = false
end)

-- DRAG MINI N

MiniN.InputBegan:Connect(function(input)
    if input.UserInputType == Enum.UserInputType.MouseButton1
    or input.UserInputType == Enum.UserInputType.Touch then
        miniDragging = true
        miniMoved = false
        miniStart = input.Position
        miniPos = MiniN.Position
    end
end)

UIS.InputChanged:Connect(function(input)
    if not miniDragging then return end

    if input.UserInputType == Enum.UserInputType.MouseMovement
    or input.UserInputType == Enum.UserInputType.Touch then
        local d = input.Position - miniStart

        if math.abs(d.X) > 5 or math.abs(d.Y) > 5 then
            miniMoved = true
        end

        if miniMoved then
            MiniN.Position = UDim2.new(
                miniPos.X.Scale, miniPos.X.Offset + d.X,
                miniPos.Y.Scale, miniPos.Y.Offset + d.Y
            )
        end
    end
end)

UIS.InputEnded:Connect(function(input)
    if input.UserInputType == Enum.UserInputType.MouseButton1
    or input.UserInputType == Enum.UserInputType.Touch then
        miniDragging = false
    end
end)

-- CLOSE: 0.4 SECONDS

