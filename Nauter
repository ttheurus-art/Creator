-- KEYBIND

function Tab:CreateKeybind(Config)
    Config = Config or {}

    local CurrentKey = Config.CurrentKey or Enum.KeyCode.RightControl
    local Listening = false

    local Container = CreateContainer(44)

    local Name = Make("TextLabel", {
        Position = UDim2.new(0, 10, 0, 0),
        Size = UDim2.new(1, -95, 1, 0),
        BackgroundTransparency = 1,
        Text = Config.Name or "Keybind",
        TextColor3 = C.White,
        TextSize = 12,
        Font = Enum.Font.Gotham,
        TextXAlignment = Enum.TextXAlignment.Left
    }, Container)

    local KeyButton = Make("TextButton", {
        AnchorPoint = Vector2.new(1, 0.5),
        Position = UDim2.new(1, -8, 0.5, 0),
        Size = UDim2.fromOffset(82, 27),
        BackgroundColor3 = C.BG,
        BorderSizePixel = 0,
        Text = CurrentKey.Name,
        TextColor3 = C.Neon,
        TextSize = 10,
        Font = Enum.Font.GothamBold,
        AutoButtonColor = false
    }, Container)
    Round(KeyButton, 7)
    Stroke(KeyButton, C.Purple, 0.45, 1)

    KeyButton.Activated:Connect(function()
        Listening = true
        KeyButton.Text = "Press key..."
    end)

    local KeyConnection
    KeyConnection = UIS.InputBegan:Connect(function(Input, Processed)
        if not Listening then
            if not Processed and Input.KeyCode == CurrentKey then
                if Config.Callback then
                    task.spawn(Config.Callback, CurrentKey)
                end
            end
            return
        end

        if Input.UserInputType ~= Enum.UserInputType.Keyboard then
            return
        end

        CurrentKey = Input.KeyCode
        Listening = false
        KeyButton.Text = CurrentKey.Name

        if Config.ChangedCallback then
            task.spawn(Config.ChangedCallback, CurrentKey)
        end
    end)

    local API = {}

    function API:Set(NewKey)
        if typeof(NewKey) == "EnumItem" then
            CurrentKey = NewKey
            KeyButton.Text = CurrentKey.Name
        end
    end

    function API:Get()
        return CurrentKey
    end

    return API
end

