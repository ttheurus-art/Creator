function WindowMethods:CreateTab(config)
    config = config or {}

    local TabName = config.Name or "Tab"
    local TabIcon = config.Icon or ""

    local TabButton = Create("TextButton", {
        Name = TabName .. "TabButton",
        Parent = TabBar,
        BackgroundColor3 = Theme.Secondary,
        BackgroundTransparency = 0.15,
        BorderSizePixel = 0,
        Size = UDim2.new(0, 120, 0, 34),
        Font = Enum.Font.GothamSemibold,
        Text = TabIcon ~= "" and (TabIcon .. "  " .. TabName) or TabName,
        TextColor3 = Theme.Text,
        TextSize = 12,
        AutoButtonColor = false,
    })

    Create("UICorner", {
        Parent = TabButton,
        CornerRadius = UDim.new(0, 10),
    })

    local Page = Create("ScrollingFrame", {
        Name = TabName .. "Page",
        Parent = Content,
        BackgroundTransparency = 1,
        BorderSizePixel = 0,
        Position = UDim2.new(0, 0, 0, 0),
        Size = UDim2.new(1, 0, 1, 0),
        CanvasSize = UDim2.new(0, 0, 0, 0),
        ScrollBarThickness = 4,
        ScrollBarImageColor3 = Theme.Accent,
        Visible = false,
    })

    Create("UIPadding", {
        Parent = Page,
        PaddingTop = UDim.new(0, 10),
        PaddingBottom = UDim.new(0, 10),
        PaddingLeft = UDim.new(0, 10),
        PaddingRight = UDim.new(0, 10),
    })

    local List = Create("UIListLayout", {
        Parent = Page,
        Padding = UDim.new(0, 10),
        SortOrder = Enum.SortOrder.LayoutOrder,
    })

    List:GetPropertyChangedSignal("AbsoluteContentSize"):Connect(function()
        Page.CanvasSize = UDim2.new(
            0,
            0,
            0,
            List.AbsoluteContentSize.Y + 20
        )
    end)

    local TabMethods = {}
    TabMethods.Button = TabButton
    TabMethods.Page = Page
    TabMethods.Name = TabName
    TabMethods.Layout = List

    TabButton.MouseButton1Click:Connect(function()
        self:SelectTab(TabName)
    end)

    TabButton.MouseEnter:Connect(function()
        TweenService:Create(
            TabButton,
            TweenInfo.new(0.15),
            {BackgroundTransparency = 0}
        ):Play()
    end)

    TabButton.MouseLeave:Connect(function()
        TweenService:Create(
            TabButton,
            TweenInfo.new(0.15),
            {BackgroundTransparency = 0.15}
        ):Play()
    end)

    self.Tabs = self.Tabs or {}
    self.Tabs[TabName] = TabMethods

    if not self.ActiveTab then
        self:SelectTab(TabName)
    end

    return TabMethods
end

function WindowMethods:SelectTab(Name)
    if not self.Tabs or not self.Tabs[Name] then
        return
    end

    for TabName, Tab in pairs(self.Tabs) do
        local IsSelected = TabName == Name

        Tab.Page.Visible = IsSelected

        TweenService:Create(
            Tab.Button,
            TweenInfo.new(0.2, Enum.EasingStyle.Quad, Enum.EasingDirection.Out),
            {
                BackgroundColor3 = IsSelected
                    and Theme.Accent
                    or Theme.Secondary,
                BackgroundTransparency = IsSelected and 0 or 0.15,
            }
        ):Play()
    end

    self.ActiveTab = Name
end

