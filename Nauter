    local PickerPanel = Create("Frame", {
        Name = "PickerPanel",
        Position = UDim2.new(0, 8, 0, 44),
        Size = UDim2.new(1, -16, 0, 90),
        BackgroundColor3 = Theme.Background,
        BackgroundTransparency = 0.05,
        BorderSizePixel = 0
    }, Container)

    AddCorner(PickerPanel, 8)
    AddStroke(PickerPanel, Theme.Border, 1, 0.6)

    -- RGB input supports values such as 233, 100, 77.
    local RGBInput = Create("TextBox", {
        Name = "RGBInput",
        Position = UDim2.new(0, 8, 0, 8),
        Size = UDim2.new(1, -16, 0, 30),
        BackgroundColor3 = Theme.PanelLight,
        BorderSizePixel = 0,
        ClearTextOnFocus = false,
        PlaceholderText = "233, 100, 77",
        PlaceholderColor3 = Theme.SubText,
        Text = "",
        TextColor3 = Theme.Text,
        TextSize = 12,
        Font = Enum.Font.Gotham,
        TextXAlignment = Enum.TextXAlignment.Center
    }, PickerPanel)

    AddCorner(RGBInput, 7)
    AddStroke(RGBInput, Theme.Border, 1, 0.65)

    local RandomButton = Create("TextButton", {
        Name = "RandomColor",
        Position = UDim2.new(0, 8, 0, 46),
        Size = UDim2.new(1, -16, 0, 30),
        BackgroundColor3 = Theme.PurpleDark,
        BorderSizePixel = 0,
        AutoButtonColor = false,
        Text = "Random Color",
        TextColor3 = Theme.White,
        TextSize = 12,
        Font = Enum.Font.GothamMedium
    }, PickerPanel)

    AddCorner(RandomButton, 7)

    local function FireColorCallback()
        local Success, ErrorMessage = pcall(
            Callback,
            CurrentColor
        )

        if not Success then
            warn("[Nauter ColorPicker Error]:", ErrorMessage)
        end
    end

    local function SetColor(Color, FireCallback)
        if typeof(Color) ~= "Color3" then
            return
        end

        CurrentColor = Color
        Preview.BackgroundColor3 = Color

        RGBInput.Text = string.format(
            "%d, %d, %d",
            math.floor(Color.R * 255 + 0.5),
            math.floor(Color.G * 255 + 0.5),
            math.floor(Color.B * 255 + 0.5)
        )

        if FireCallback ~= false then
            FireColorCallback()
        end
    end

    local function ParseRGB(Text)
        local R, G, B = Text:match(
            "^%s*(%d+)%s*,%s*(%d+)%s*,%s*(%d+)%s*$"
        )

        if not R or not G or not B then
            return nil
        end

        R = tonumber(R)
        G = tonumber(G)
        B = tonumber(B)

        if R > 255 or G > 255 or B > 255 then
            return nil
        end

        return Color3.fromRGB(R, G, B)
    end

    RGBInput.FocusLost:Connect(function()
        local Color = ParseRGB(RGBInput.Text)

        if Color then
            SetColor(Color, true)
        else
            SetColor(CurrentColor, false)
        end
    end)

    RandomButton.Activated:Connect(function()
        local Color = Color3.fromRGB(
            math.random(0, 255),
            math.random(0, 255),
            math.random(0, 255)
        )

        SetColor(Color, true)
    end)

    HeaderButton.Activated:Connect(function()
        Expanded = not Expanded

        Arrow.Text = Expanded and "^" or "v"

        PlayTween(Container, 0.2, {
            Size = Expanded
                and UDim2.new(1, 0, 0, 142)
                or UDim2.new(1, 0, 0, 42)
        })
    end)

    SetColor(CurrentColor, false)

    return {
        Instance = Container,
        Preview = Preview,
        Input = RGBInput,

        Set = function(_, Color)
            SetColor(Color, true)
        end,

        Get = function()
            return CurrentColor
        end
    }
end

