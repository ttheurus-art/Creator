-- SLIDER
function TabMethods:CreateSlider(config)
    config = config or {}

    local Tab = self
    local Callback = config.Callback or function() end
    local Minimum = tonumber(config.Range and config.Range[1]) or 0
    local Maximum = tonumber(config.Range and config.Range[2]) or 100
    local Increment = math.max(tonumber(config.Increment) or 1, 0.000001)

    if Maximum < Minimum then
        Minimum, Maximum = Maximum, Minimum
    end

    local Default = tonumber(config.CurrentValue)
        or tonumber(config.Default)
        or Minimum

    local CurrentValue = math.clamp(Default, Minimum, Maximum)

    local Container = CreateContainer(
        Tab,
        config.Name or "Slider",
        65
    )

    Container.ClipsDescendants = false

    local Title = AddText(
        Container,
        tostring(config.Name or "Slider"),
        12,
        Theme.Text,
        Enum.Font.GothamMedium
    )

    Title.Position = UDim2.new(0, 10, 0, 5)
    Title.Size = UDim2.new(1, -90, 0, 20)

    local ValueLabel = AddText(
        Container,
        tostring(CurrentValue),
        12,
        Theme.Purple,
        Enum.Font.GothamBold
    )

    ValueLabel.Name = "Value"
    ValueLabel.TextXAlignment = Enum.TextXAlignment.Right
    ValueLabel.Position = UDim2.new(1, -75, 0, 5)
    ValueLabel.Size = UDim2.fromOffset(65, 20)

    local Bar = Create("Frame", {
        Name = "Bar",
        Position = UDim2.new(0, 10, 0, 38),
        Size = UDim2.new(1, -20, 0, 7),
        BackgroundColor3 = Color3.fromRGB(55, 47, 68),
        BorderSizePixel = 0
    }, Container)

    AddCorner(Bar, 5)

    local Fill = Create("Frame", {
        Name = "Fill",
        Size = UDim2.new(0, 0, 1, 0),
        BackgroundColor3 = Theme.Purple,
        BorderSizePixel = 0
    }, Bar)

    AddCorner(Fill, 5)

    local Knob = Create("Frame", {
        Name = "Knob",
        AnchorPoint = Vector2.new(0.5, 0.5),
        Position = UDim2.new(0, 0, 0.5, 0),
        Size = UDim2.fromOffset(15, 15),
        BackgroundColor3 = Theme.White,
        BorderSizePixel = 0,
        ZIndex = 2
    }, Bar)

    AddCorner(Knob, 8)

    local Hitbox = Create("TextButton", {
        Name = "Hitbox",
        AnchorPoint = Vector2.new(0.5, 0.5),
        Position = UDim2.new(0.5, 0, 0.5, 0),
        Size = UDim2.new(1, 12, 0, 28),
        BackgroundTransparency = 1,
        Text = "",
        AutoButtonColor = false,
        ZIndex = 3
    }, Bar)

    local Dragging = false

    local function FormatNumber(Value)
        if Value == math.floor(Value) then
            return tostring(math.floor(Value))
        end

        return string.format("%.3f", Value):gsub("0+$", ""):gsub("%.$", "")
    end

    local function UpdateVisual()
        local Alpha = 0

        if Maximum > Minimum then
            Alpha = (CurrentValue - Minimum) / (Maximum - Minimum)
        end

        Alpha = math.clamp(Alpha, 0, 1)

        Fill.Size = UDim2.new(Alpha, 0, 1, 0)
        Knob.Position = UDim2.new(Alpha, 0, 0.5, 0)
        ValueLabel.Text = FormatNumber(CurrentValue)
    end

    local function SetValue(Value, FireCallback)
        Value = tonumber(Value)

        if not Value then
            return
        end

        Value = math.clamp(Value, Minimum, Maximum)

        local Steps = math.floor(
            ((Value - Minimum) / Increment) + 0.5
        )

        CurrentValue = math.clamp(
            Minimum + Steps * Increment,
            Minimum,
            Maximum
        )

        UpdateVisual()

        if FireCallback ~= false then
            local Success, ErrorMessage = pcall(
                Callback,
                CurrentValue
            )

            if not Success then
                warn("[Nauter Slider Error]:", ErrorMessage)
            end
        end
    end

    local function UpdateFromPosition(X)
        local Width = Bar.AbsoluteSize.X

        if Width <= 0 then
            return
        end

        local Alpha = math.clamp(
            (X - Bar.AbsolutePosition.X) / Width,
            0,
            1
        )

        SetValue(
            Minimum + (Maximum - Minimum) * Alpha,
            true
        )
    end

    Hitbox.InputBegan:Connect(function(Input)
        if Input.UserInputType == Enum.UserInputType.MouseButton1
            or Input.UserInputType == Enum.UserInputType.Touch then

            Dragging = true
            UpdateFromPosition(Input.Position.X)
        end
    end)

    local SliderInputConnection =
        UserInputService.InputChanged:Connect(function(Input)
            if not Dragging then
                return
            end

            if Input.UserInputType == Enum.UserInputType.MouseMovement
                or Input.UserInputType == Enum.UserInputType.Touch then

                UpdateFromPosition(Input.Position.X)
            end
        end)

    local SliderEndConnection =
        UserInputService.InputEnded:Connect(function(Input)
            if Input.UserInputType == Enum.UserInputType.MouseButton1
                or Input.UserInputType == Enum.UserInputType.Touch then

                Dragging = false
            end
        end)

    table.insert(Tab.Window.Connections, SliderInputConnection)
    table.insert(Tab.Window.Connections, SliderEndConnection)

    UpdateVisual()

    return {
        Instance = Container,
        Bar = Bar,

        Set = function(_, Value)
            SetValue(Value, true)
        end,

        Get = function()
            return CurrentValue
        end
    }
end

