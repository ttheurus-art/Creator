-- LIBRARY API
local Nauter = {}
local Tabs = {}
local SelectedTab

local function ClearContent()
    for _, child in ipairs(Content:GetChildren()) do
        if child ~= ContentLayout
        and not child:IsA("UIPadding") then
            child:Destroy()
        end
    end
end

local function SelectTab(tab)
    SelectedTab = tab
    ClearContent()

    for _, item in ipairs(Tabs) do
        item.Button.BackgroundColor3 =
            item == tab and C.Purple or C.Panel
    end

    tab.Render()
    Content.CanvasPosition = Vector2.new(0, 0)
end

function Nauter:CreateTab(name)
    local tab = {
        Name = name,
        Items = {}
    }

    local button = Make("TextButton", {
        Name = name,
        Size = UDim2.new(1, 0, 0, 34),
        BackgroundColor3 = C.Panel,
        BackgroundTransparency = 0.05,
        Text = name,
        TextColor3 = C.White,
        Font = Enum.Font.GothamBold,
        TextSize = 11,
        TextTruncate = Enum.TextTruncate.AtEnd,
        AutoButtonColor = false
    }, Sidebar)

    Round(button, 9)

    tab.Button = button

    function tab:Render()
        for _, item in ipairs(self.Items) do
            item()
        end
    end

    button.Activated:Connect(function()
        SelectTab(tab)
    end)

    table.insert(Tabs, tab)

    if not SelectedTab then
        SelectTab(tab)
    end

    local function AddItem(callback)
        table.insert(tab.Items, callback)
        if SelectedTab == tab then
            ClearContent()
            tab:Render()
        end
    end

    function tab:CreateSection(text)
        AddItem(function()
            Make("TextLabel", {
                Size = UDim2.new(1, -3, 0, 24),
                BackgroundTransparency = 1,
                Text = string.upper(text),
                TextColor3 = C.Neon,
                Font = Enum.Font.GothamBold,
                TextSize = 11,
                TextXAlignment = Enum.TextXAlignment.Left
            }, Content)
        end)
    end

    function tab:CreateParagraph(options)
        AddItem(function()
            local box = Make("Frame", {
                Size = UDim2.new(1, -3, 0, 66),
                BackgroundColor3 = C.Panel,
                BackgroundTransparency = 0.05
            }, Content)
            Round(box, 10)

            Make("TextLabel", {
                Position = UDim2.new(0, 10, 0, 6),
                Size = UDim2.new(1, -20, 0, 19),
                BackgroundTransparency = 1,
                Text = options.Title or "Paragraph",
                TextColor3 = C.Neon,
                Font = Enum.Font.GothamBold,
                TextSize = 12,
                TextXAlignment = Enum.TextXAlignment.Left
            }, box)

            Make("TextLabel", {
                Position = UDim2.new(0, 10, 0, 27),
                Size = UDim2.new(1, -20, 0, 32),
                BackgroundTransparency = 1,
                Text = options.Content or "",
                TextColor3 = C.Muted,
                Font = Enum.Font.Gotham,
                TextSize = 11,
                TextWrapped = true,
                TextXAlignment = Enum.TextXAlignment.Left,
                TextYAlignment = Enum.TextYAlignment.Top
            }, box)
        end)
    end

    function tab:CreateButton(options)
        AddItem(function()
            local b = Make("TextButton", {
                Size = UDim2.new(1, -3, 0, 38),
                BackgroundColor3 = C.Panel,
                BackgroundTransparency = 0.05,
                Text = options.Name or "Button",
                TextColor3 = C.White,
                Font = Enum.Font.GothamMedium,
                TextSize = 12,
                AutoButtonColor = false
            }, Content)

            Round(b, 10)
            Stroke(b, C.Purple)

            b.Activated:Connect(function()
                TweenService:Create(b, TweenInfo.new(0.1), {
                    BackgroundColor3 = C.Purple
                }):Play()

                task.delay(0.15, function()
                    if b.Parent then
                        b.BackgroundColor3 = C.Panel
                    end
                end)

                if options.Callback then
                    options.Callback()
                end
            end)
        end)
    end

    function tab:CreateToggle(options)
        local value = options.Default == true
        local control = {}

        function control:Set(newValue)
            value = newValue == true
            if control.Refresh then
                control.Refresh()
            end
            if options.Callback then
                options.Callback(value)
            end
        end

        AddItem(function()
            local b = Make("TextButton", {
                Size = UDim2.new(1, -3, 0, 40),
                BackgroundColor3 = C.Panel,
                BackgroundTransparency = 0.05,
                Text = "",
                AutoButtonColor = false
            }, Content)

            Round(b, 10)

            Make("TextLabel", {
                Position = UDim2.new(0, 10, 0, 0),
                Size = UDim2.new(1, -65, 1, 0),
                BackgroundTransparency = 1,
                Text = options.Name or "Toggle",
                TextColor3 = C.White,
                Font = Enum.Font.GothamMedium,
                TextSize = 11,
                TextXAlignment = Enum.TextXAlignment.Left
            }, b)

            local switch = Make("Frame", {
                Position = UDim2.new(1, -43, 0.5, -9),
                Size = UDim2.fromOffset(33, 18),
                BackgroundColor3 = value and C.Purple or C.Off
            }, b)
            Round(switch, 20)

            local dot = Make("Frame", {
                Position = value and UDim2.new(1, -16, 0, 2)
                    or UDim2.new(0, 2, 0, 2),
                Size = UDim2.fromOffset(14, 14),
                BackgroundColor3 = C.White
            }, switch)
            Round(dot, 20)

            function control.Refresh()
                if not b.Parent then return end
                switch.BackgroundColor3 =
                    value and C.Purple or C.Off
                dot.Position = value
                    and UDim2.new(1, -16, 0, 2)
                    or UDim2.new(0, 2, 0, 2)
            end

            b.Activated:Connect(function()
                control:Set(not value)
            end)
        end)

        return control
    end

    function tab:CreateSlider(options)
        local min = options.Min or 0
        local max = options.Max or 100
        assert(max > min, "Slider Max must exceed Min")

        local value = math.clamp(
            options.Default or min, min, max
        )

        local control = {}

        function control:Set(newValue)
            value = math.clamp(
                math.floor(newValue + 0.5), min, max
            )
            if control.Refresh then
                control.Refresh()
            end
            if options.Callback then
                options.Callback(value)
            end
        end

        AddItem(function()
            local box = Make("Frame", {
                Size = UDim2.new(1, -3, 0, 60),
                BackgroundColor3 = C.Panel,
                BackgroundTransparency = 0.05
            }, Content)
            Round(box, 10)

            local label = Make("TextLabel", {
                Position = UDim2.new(0, 10, 0, 5),
                Size = UDim2.new(1, -20, 0, 19),
                BackgroundTransparency = 1,
                Text = (options.Name or "Slider") .. ": " .. value,
                TextColor3 = C.White,
                Font = Enum.Font.GothamMedium,
                TextSize = 11,
                TextXAlignment = Enum.TextXAlignment.Left
            }, box)

            local bar = Make("Frame", {
                Position = UDim2.new(0, 10, 0, 37),
                Size = UDim2.new(1, -20, 0, 6),
                BackgroundColor3 = C.Off
            }, box)
            Round(bar, 5)

            local fill = Make("Frame", {
                Size = UDim2.new(
                    (value - min) / (max - min), 0, 1, 0
                ),
                BackgroundColor3 = C.Purple
            }, bar)
            Round(fill, 5)

            local hit = Make("TextButton", {
                Position = UDim2.new(0, 0, 0, 27),
                Size = UDim2.new(1, 0, 0, 28),
                BackgroundTransparency = 1,
                Text = ""
            }, box)

            local function SetFromX(x)
                local width = bar.AbsoluteSize.X
                if width <= 0 then return end

                control:Set(min + math.clamp(
                    (x - bar.AbsolutePosition.X) / width,
                    0, 1
                ) * (max - min))
            end

            local active = false

            hit.InputBegan:Connect(function(input)
                if input.UserInputType == Enum.UserInputType.Touch
                or input.UserInputType == Enum.UserInputType.MouseButton1 then
                    active = true
                    SetFromX(input.Position.X)
                end
            end)

            UIS.InputChanged:Connect(function(input)
                if active and (
                    input.UserInputType == Enum.UserInputType.Touch
                    or input.UserInputType == Enum.UserInputType.MouseMovement
                ) then
                    SetFromX(input.Position.X)
                end
            end)

            UIS.InputEnded:Connect(function(input)
                if input.UserInputType == Enum.UserInputType.Touch
                or input.UserInputType == Enum.UserInputType.MouseButton1 then
                    active = false
                end
            end)

            function control.Refresh()
                if not box.Parent then return end
                fill.Size = UDim2.new(
                    (value - min) / (max - min), 0, 1, 0
                )
                label.Text = (options.Name or "Slider") .. ": " .. value
            end
        end)

        return control
    end

    return tab
end

-- PUBLIC API
function Nauter:Destroy()
    Gui:Destroy()
end

function Nauter:SetVisible(state)
    Main.Visible = state == true
    Show.Visible = not Main.Visible
end

function Nauter:GetGui()
    return Gui
end

