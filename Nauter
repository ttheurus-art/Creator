local function Clear()
    for _, v in ipairs(Content:GetChildren()) do
        if v:IsA("GuiObject")
        and not v:IsA("UIListLayout")
        and not v:IsA("UIPadding") then
            v:Destroy()
        end
    end
end

local function Section(text)
