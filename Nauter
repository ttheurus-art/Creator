function Nauter:CreateWindow(Config)
    Config = Config or {}

    Title.Text = Config.Name or "NAUTER"

    local Window = {}
    local ActiveTabButton

    function Window:CreateTab(TabConfig)
        TabConfig = TabConfig or {}
        TabCount += 1

        local TabName = TabConfig.Name or ("Tab " .. TabCount)

        -- TAB BUTTON

        local TabButton = Make("TextButton", {
            Name = "Tab_" .. TabCount,
            Size = UDim2.new(1, 0, 0, 36),
            BackgroundColor3 = C.Panel,
            BackgroundTransparency = 1,
            BorderSizePixel = 0,
            Text = TabName,
            TextColor3 = C.Muted,
            TextSize = 11,
            Font = Enum.Font.GothamMedium,
            TextWrapped = true,
            AutoButtonColor = false,
            LayoutOrder = TabCount
        }, Sidebar)

        Round(TabButton, 8)

        local TabIndicator = Make("Frame", {
            Name = "Indicator",
            Position = UDim2.new(0, 0, 0.2, 0),
            Size = UDim2.new(0, 3, 0.6, 0),
            BackgroundColor3 = C.Purple,
            BorderSizePixel = 0,
            Visible = false
        }, TabButton)

        Round(TabIndicator, 3)

        -- TAB PAGE

        local Page = Make("ScrollingFrame", {
            Name = "Page_" .. TabCount,
            Size = UDim2.fromScale(1, 1),
            BackgroundTransparency = 1,
            BorderSizePixel = 0,
            ScrollBarThickness = 3,
            ScrollBarImageColor3 = C.Purple,
            CanvasSize = UDim2.new(),
            AutomaticCanvasSize = Enum.AutomaticSize.Y,
            Visible = false
        }, PageHolder)

        Make("UIListLayout", {
            Padding = UDim.new(0, 8),
            SortOrder = Enum.SortOrder.LayoutOrder
        }, Page)

        Make("UIPadding", {
            PaddingTop = UDim.new(0, 8),
            PaddingBottom = UDim.new(0, 10),
            PaddingLeft = UDim.new(0, 8),
            PaddingRight = UDim.new(0, 8)
        }, Page)

        local Tab = {}
        local Elements = {}

        local function SelectTab()
            for _, Other in ipairs(Tabs) do
                Other.Page.Visible = false
                Other.Button.BackgroundTransparency = 1
                Other.Button.TextColor3 = C.Muted
                Other.Indicator.Visible = false
            end

            Page.Visible = true
            TabButton.BackgroundTransparency = 0
            TabButton.BackgroundColor3 = C.Purple
            TabButton.TextColor3 = C.White
            TabIndicator.Visible = true

            CurrentTab = Tab
            ActiveTabButton = TabButton
        end

        TabButton.Activated:Connect(SelectTab)

        table.insert(Tabs, {
            Page = Page,
            Button = TabButton,
            Indicator = TabIndicator
        })

        if TabCount == 1 then
            SelectTab()
        end

        -- ELEMENT HELPERS

        local function CreateContainer(height)
            local Container = Make("Frame", {
                Size = UDim2.new(1, 0, 0, height),
                BackgroundColor3 = C.Panel,
                BackgroundTransparency = 0.05,
                BorderSizePixel = 0,
                AutomaticSize = Enum.AutomaticSize.None
            }, Page)

            Round(Container, 9)
            return Container
        end

        local function CreateText(parent, text, size, color, bold)
            return Make("TextLabel", {
                Size = UDim2.new(1, -16, 1, 0),
                Position = UDim2.new(0, 8, 0, 0),
                BackgroundTransparency = 1,
                Text = tostring(text or ""),
                TextColor3 = color or C.White,
                TextSize = size or 12,
                Font = bold and Enum.Font.GothamBold
                    or Enum.Font.Gotham,
                TextWrapped = true,
                TextXAlignment = Enum.TextXAlignment.Left,
                TextYAlignment = Enum.TextYAlignment.Center
            }, parent)
        end

        -- BUTTON

        function Tab:CreateButton(Config)
            Config = Config or {}

            local Container = CreateContainer(38)

            local Button = Make("TextButton", {
                Size = UDim2.new(1, -8, 1, -8),
                Position = UDim2.new(0, 4, 0, 4),
                BackgroundColor3 = C.Purple,
                BorderSizePixel = 0,
                Text = Config.Name or "Button",
                TextColor3 = C.White,
                TextSize = 12,
                Font = Enum.Font.GothamBold,
                AutoButtonColor = false
            }, Container)

            Round(Button, 7)

            Button.Activated:Connect(function()
                if Config.Callback then
                    task.spawn(Config.Callback)
                end
            end)

            return Button
        end

        -- LABEL

        function Tab:CreateLabel(Config)
            local Text = type(Config) == "table"
                and (Config.Name or Config.Text or "")
                or tostring(Config or "")

            local Container = CreateContainer(32)
            local LabelObject = CreateText(
                Container, Text, 12, C.White, false
            )

            return {
                Set = function(_, NewText)
                    LabelObject.Text = tostring(NewText or "")
                end
            }
        end

        -- DIVIDER

        function Tab:CreateDivider()
            local Container = Make("Frame", {
                Size = UDim2.new(1, 0, 0, 2),
                BackgroundColor3 = C.Purple,
                BackgroundTransparency = 0.35,
                BorderSizePixel = 0
            }, Page)

            Round(Container, 1)
            return Container
        end

        -- PARAGRAPH

        function Tab:CreateParagraph(Config)
            Config = Config or {}

            local Container = CreateContainer(68)

            local Heading = Make("TextLabel", {
                Position = UDim2.new(0, 9, 0, 5),
                Size = UDim2.new(1, -18, 0, 20),
                BackgroundTransparency = 1,
                Text = Config.Title or "Paragraph",
                TextColor3 = C.Neon,
                TextSize = 12,
                Font = Enum.Font.GothamBold,
                TextXAlignment = Enum.TextXAlignment.Left
            }, Container)

            local Content = Make("TextLabel", {
                Position = UDim2.new(0, 9, 0, 26),
                Size = UDim2.new(1, -18, 1, -31),
                BackgroundTransparency = 1,
                Text = Config.Content or "",
                TextColor3 = C.Muted,
                TextSize = 11,
                Font = Enum.Font.Gotham,
                TextWrapped = true,
                TextXAlignment = Enum.TextXAlignment.Left,
                TextYAlignment = Enum.TextYAlignment.Top
            }, Container)

            return {
                Set = function(_, NewContent)
                    Content.Text = tostring(NewContent or "")
                end,
                SetTitle = function(_, NewTitle)
                    Heading.Text = tostring(NewTitle or "")
                end
            }
        end

        -- SECTION

        function Tab:CreateSection(Config)
            local Name = type(Config) == "table"
                and (Config.Name or "Section")
                or tostring(Config or "Section")

            local Section = Make("TextLabel", {
                Size = UDim2.new(1, 0, 0, 24),
                BackgroundTransparency = 1,
                Text = Name,
                TextColor3 = C.Neon,
                TextSize = 12,
                Font = Enum.Font.GothamBold,
                TextXAlignment = Enum.TextXAlignment.Left
            }, Page)

            return Section
        end

        -- RETURN TAB API

        Tab.Name = TabName
        Tab.Page = Page
        Tab.Button = TabButton
        Tab.Select = SelectTab

        return Tab
    end

    -- NOTIFICATION METHOD
    -- Notification implementation is added in Part 4.

    function Window:Destroy()
        if Gui then
            Gui:Destroy()
        end
    end

    Window.Name = Config.Name or "NAUTER"
    Window.Main = Main

    return Window
end

