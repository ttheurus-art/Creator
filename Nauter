function Nauter:CreateWindow(config)
    config = config or {}

    local PlayerGui = LocalPlayer:WaitForChild("PlayerGui")

    -- Remove previous GUI on re-execution.
    local OldGui = PlayerGui:FindFirstChild("Nauter")

    if OldGui then
        OldGui:Destroy()
    end

    local ScreenGui = Create("ScreenGui", {
        Name = "Nauter",
        ResetOnSpawn = false,
        IgnoreGuiInset = true,
        ZIndexBehavior = Enum.ZIndexBehavior.Sibling,
        DisplayOrder = 100
    }, PlayerGui)

    local Window = setmetatable({
        Gui = ScreenGui,
        Connections = {},
        Tabs = {},
        SelectedTab = nil,
        IsMinimized = false,
        IsDestroyed = false,
        Name = config.Name or "Nauter",
        Notifications = {},
        _NotificationCount = 0
    }, {
        __index = WindowMethods
    })

    -- Main window: compact size for phone and tablet.
    local Main = Create("Frame", {
        Name = "Main",
        AnchorPoint = Vector2.new(0.5, 0.5),
        Position = UDim2.fromScale(0.5, 0.5),
        Size = UDim2.fromOffset(460, 330),
        BackgroundColor3 = Theme.Background,
        BackgroundTransparency = 0.1,
        BorderSizePixel = 0,
        ClipsDescendants = true
    }, ScreenGui)

    Window.Main = Main

    AddCorner(Main, 16)
    AddStroke(Main, Theme.Border, 1.4, 0.1)
    AddGradient(Main)

    -- Responsive scaling.
    local Scale = Create("UIScale", {
        Scale = 1
    }, Main)

    Window.Scale = Scale

    local function UpdateScale()
        local Camera = workspace.CurrentCamera

        if not Camera then
            return
        end

        local Viewport = Camera.ViewportSize
        local ShortSide = math.min(Viewport.X, Viewport.Y)

        if ShortSide < 500 then
            Scale.Scale = 0.72
        elseif ShortSide < 750 then
            Scale.Scale = 0.86
        else
            Scale.Scale = 1
        end
    end

    UpdateScale()

    local Camera = workspace.CurrentCamera

    if Camera then
        table.insert(
            Window.Connections,
            Camera:GetPropertyChangedSignal("ViewportSize"):Connect(UpdateScale)
        )
    end

    -- Header.
    local Header = Create("Frame", {
        Name = "Header",
        Size = UDim2.new(1, 0, 0, 40),
        BackgroundColor3 = Theme.Background,
        BackgroundTransparency = 0.05,
        BorderSizePixel = 0,
        ZIndex = 2
    }, Main)

    Window.Header = Header

    AddCorner(Header, 16)

    -- Cover the bottom rounded corners of the header.
    Create("Frame", {
        Name = "HeaderBottomCover",
        Position = UDim2.new(0, 0, 1, -12),
        Size = UDim2.new(1, 0, 0, 12),
        BackgroundColor3 = Theme.Background,
        BackgroundTransparency = 0.05,
        BorderSizePixel = 0,
        ZIndex = 2
    }, Header)

    local HeaderTitle = AddText(
        Header,
        Window.Name,
        14,
        Theme.Text,
        Enum.Font.GothamBold
    )

    HeaderTitle.Name = "Title"
    HeaderTitle.Position = UDim2.new(0, 12, 0, 0)
    HeaderTitle.Size = UDim2.new(1, -94, 1, 0)
    HeaderTitle.ZIndex = 3

    Window.TitleLabel = HeaderTitle

    -- Minimize button.
    local MinimizeButton = Create("TextButton", {
        Name = "Minimize",
        Position = UDim2.new(1, -62, 0, 7),
        Size = UDim2.fromOffset(23, 25),
        BackgroundColor3 = Theme.PanelLight,
        BorderSizePixel = 0,
        AutoButtonColor = false,
        Text = "-",
        TextSize = 20,
        TextColor3 = Theme.Text,
        Font = Enum.Font.GothamBold,
        ZIndex = 4
    }, Header)

    AddCorner(MinimizeButton, 8)

    -- Close button.
    local CloseButton = Create("TextButton", {
        Name = "Close",
        Position = UDim2.new(1, -33, 0, 7),
        Size = UDim2.fromOffset(23, 25),
        BackgroundColor3 = Color3.fromRGB(100, 35, 58),
        BorderSizePixel = 0,
        AutoButtonColor = false,
        Text = "×",
        TextSize = 16,
        TextColor3 = Theme.White,
        Font = Enum.Font.GothamBold,
        ZIndex = 4
    }, Header)

    AddCorner(CloseButton, 8)

    Window.MinimizeButton = MinimizeButton
    Window.CloseButton = CloseButton

    -- Tab navigation.
    local TabBar = Create("ScrollingFrame", {
        Name = "TabBar",
        Position = UDim2.new(0, 9, 0, 47),
        Size = UDim2.new(1, -18, 0, 32),
        BackgroundColor3 = Theme.Panel,
        BackgroundTransparency = 0.15,
        BorderSizePixel = 0,
        ScrollBarThickness = 2,
        ScrollBarImageColor3 = Theme.Purple,
        ScrollingDirection = Enum.ScrollingDirection.X,
        CanvasSize = UDim2.new()
    }, Main)

    AddCorner(TabBar, 10)

    local TabLayout = Create("UIListLayout", {
        FillDirection = Enum.FillDirection.Horizontal,
        SortOrder = Enum.SortOrder.LayoutOrder,
        Padding = UDim.new(0, 5)
    }, TabBar)

    AddPadding(TabBar, 5, 5, 3, 3)

    Window.TabBar = TabBar
    Window.TabLayout = TabLayout

    table.insert(
        Window.Connections,
        TabLayout:GetPropertyChangedSignal("AbsoluteContentSize"):Connect(function()
            TabBar.CanvasSize = UDim2.new(
                0,
                TabLayout.AbsoluteContentSize.X + 10,
                0,
                0
            )
        end)
    )

    -- Content area.
    local Content = Create("Frame", {
        Name = "Content",
        Position = UDim2.new(0, 9, 0, 87),
        Size = UDim2.new(1, -18, 1, -96),
        BackgroundColor3 = Theme.Panel,
        BackgroundTransparency = 0.13,
        BorderSizePixel = 0,
        ClipsDescendants = true
    }, Main)

    AddCorner(Content, 12)
    AddStroke(Content, Theme.Border, 1, 0.65)

    Window.Content = Content

    -- Floating restore button.
    local FloatingButton = Create("TextButton", {
        Name = "NauterRestore",
        AnchorPoint = Vector2.new(0, 0),
        Position = UDim2.new(0, 12, 0.5, -22),
        Size = UDim2.fromOffset(44, 44),
        BackgroundColor3 = Theme.PurpleDark,
        BackgroundTransparency = 0.05,
        BorderSizePixel = 0,
        Text = "N",
        TextColor3 = Theme.White,
        TextSize = 21,
        Font = Enum.Font.GothamBold,
        Visible = false,
        ZIndex = 20
    }, ScreenGui)

    AddCorner(FloatingButton, 22)
    AddStroke(FloatingButton, Theme.Purple, 1.5, 0)

    Window.FloatingButton = FloatingButton

    -- Make the floating button draggable too.
    ConnectDrag(FloatingButton, FloatingButton, Window.Connections)

    -- Save normal window dimensions.
    local NormalSize = Main.Size
    local NormalPosition = Main.Position

    -- Drag the window using its header.
    ConnectDrag(Header, Main, Window.Connections)

    -- Minimize animation.
    table.insert(
        Window.Connections,
        MinimizeButton.Activated:Connect(function()
            if Window.IsMinimized or Window.IsDestroyed then
                return
            end

            Window.IsMinimized = true
            NormalSize = Main.Size
            NormalPosition = Main.Position

            PlayTween(Main, 0.25, {
                Size = UDim2.fromOffset(0, 0),
                BackgroundTransparency = 1
            })

            task.delay(0.26, function()
                if Window.IsDestroyed then
                    return
                end

                Main.Visible = false
                Main.Size = NormalSize
                Main.BackgroundTransparency = 0.1
                FloatingButton.Visible = true
            end)
        end)
    )

    -- Restore window.
    table.insert(
        Window.Connections,
        FloatingButton.Activated:Connect(function()
            if Window.IsDestroyed then
                return
            end

            Window.IsMinimized = false
            FloatingButton.Visible = false

            Main.Visible = true
            Main.Size = UDim2.fromOffset(0, 0)
            Main.Position = NormalPosition

            PlayTween(Main, 0.3, {
                Size = NormalSize,
                BackgroundTransparency = 0.1
            })
        end)
    )

    -- Close window.
    table.insert(
        Window.Connections,
        CloseButton.Activated:Connect(function()
            Window:Destroy()
        end)
    )

    -- Hover effects.
    for _, Button in ipairs({MinimizeButton, CloseButton}) do
        table.insert(
            Window.Connections,
            Button.MouseEnter:Connect(function()
                if Button == CloseButton then
                    Button.BackgroundColor3 = Theme.Red
                else
                    Button.BackgroundColor3 = Theme.PurpleDark
                end
            end)
        )

        table.insert(
            Window.Connections,
            Button.MouseLeave:Connect(function()
                if Button == CloseButton then
                    Button.BackgroundColor3 = Color3.fromRGB(100, 35, 58)
                else
                    Button.BackgroundColor3 = Theme.PanelLight
                end
            end)
        )
    end

    return Window
end

