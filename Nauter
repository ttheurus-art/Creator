local Camera = workspace.CurrentCamera

local function Resize()
    local v = Camera.ViewportSize
    local w = v.X < 600 and 0.94
        or v.X < 1000 and 0.82 or 0.70
    local h = math.min(v.Y * 0.76, 540)

    Main.Size = UDim2.new(w, 0, 0, h)
    Main.Position = UDim2.new((1-w)/2, 0, 0.5, -h/2)
end

