function TabMethods:CreateSlider(config)
    config = config or {}

    local Minimum = config.Range and config.Range[1] or 0
    local Maximum = config.Range and config.Range[2] or 100
    local Increment = config.Increment or 1
    local Value = math.clamp(
        config.CurrentValue or config.Default or Minimum,
        Minimum,
        Maximum
    )

    local Container = CreateContainer(
        self,
        config.Name or "Slider",
        76
    )

    local Title = Create("TextLabel", {
        Parent = Container,
        BackgroundTransparency = 1,
        Position = UDim2.new(0, 14, 0, 7),
        Size = UDim2.new(1, -85, 0, 22),
        Font = Enum.Font.GothamSemibold,
        Text = config.Name or "Slider",
        TextColor3 = Theme.Text,
        TextSize = 13,
        TextXAlignment = Enum.TextXAlignment.Left,
    })

    local ValueLabel = Create("TextLabel", {
        Parent = Container,
        BackgroundTransparency = 1,
        Position = UDim2.new(1, -70, 0, 7),
        Size = UDim2.new(0, 56, 0, 22),
        Font = Enum.Font.GothamBold,
        Text = tostring(Value),
        TextColor3 = Theme.Accent,
        TextSize = 13,
        TextXAlignment = Enum.TextXAlignment.Right,
    })

    local Track = Create("TextButton", {
        Parent = Container,
        Position = UDim2.new(0, 14, 0, 43),
        Size = UDim2.new(1, -28, 0, 10),
        BackgroundColor3 = Theme.Border,
        BorderSizePixel = 0,
        Text = "",
        AutoButtonColor = false,
    })

    Create("UICorner", {
        Parent = Track,
        CornerRadius = UDim.new(1, 0),
    })

    local Fill = Create("Frame", {
        Parent = Track,
        Size = UDim2.new(
            (Value - Minimum) / math.max(1, Maximum - Minimum),
            0,
            1,
            0
        ),
        BackgroundColor3 = Theme.Accent,
        BorderSizePixel = 0,
    })

    Create("UICorner", {
        Parent = Fill,
        CornerRadius = UDim.new(1, 0),
    })

    local Knob = Create("Frame", {
        Parent = Track,
        AnchorPoint = Vector2.new(0.5, 0.5),
        Position = UDim2.new(
            (Value - Minimum) / math.max(1, Maximum - Minimum),
            0,
            0.5,
            0
        ),
        Size = UDim2.new(0, 16, 0, 16),
        BackgroundColor3 = Color3.fromRGB(255, 255, 255),
        BorderSizePixel = 0,
        ZIndex = 2,
    })

    Create("UICorner", {
        Parent = Knob,
        CornerRadius = UDim.new(1, 0),
    })

    local Dragging = false

    local function SetValue(NewValue)
        NewValue = math.clamp(NewValue, Minimum, Maximum)
        NewValue = Minimum
            + math.floor((NewValue - Minimum) / Increment + 0.5) * Increment

        Value = math.clamp(NewValue, Minimum, Maximum)

        local Percent = (Value - Minimum) / math.max(1, Maximum - Minimum)

        ValueLabel.Text = tostring(Value)

        TweenService:Create(
            Fill,
            TweenInfo.new(0.1),
            {Size = UDim2.new(Percent, 0, 1, 0)}
        ):Play()

        TweenService:Create(
            Knob,
            TweenInfo.new(0.1),
            {Position = UDim2.new(Percent, 0, 0.5, 0)}
        ):Play()

        if config.Callback then
            task.spawn(config.Callback, Value)
        end
    end

    local function UpdateFromInput(Input)
        local Percent = math.clamp(
            (Input.Position.X - Track.AbsolutePosition.X)
                / math.max(1, Track.AbsoluteSize.X),
            0,
            1
        )

        SetValue(Minimum + (Maximum - Minimum) * Percent)
    end

    Track.InputBegan:Connect(function(Input)
        if Input.UserInputType == Enum.UserInputType.MouseButton1
            or Input.UserInputType == Enum.UserInputType.Touch then

            Dragging = true
            UpdateFromInput(Input)
        end
    end)

    UserInputService.InputChanged:Connect(function(Input)
        if Dragging then
            if Input.UserInputType == Enum.UserInputType.MouseMovement
                or Input.UserInputType == Enum.UserInputType.Touch then

                UpdateFromInput(Input)
            end
        end
    end)

    UserInputService.InputEnded:Connect(function(Input)
        if Input.UserInputType == Enum.UserInputType.MouseButton1
            or Input.UserInputType == Enum.UserInputType.Touch then

            Dragging = false
        end
    end)

    return {
        Set = function(_, NewValue)
            SetValue(NewValue)
        end,

        Get = function()
            return Value
        end,
    }
end

