-- MOBILE SIDEBAR
local function AdaptLayout()
    local mobile = Camera.ViewportSize.X < 500

    Sidebar.Size = UDim2.new(0, mobile and 74 or 105, 1, 0)
    Content.Position = UDim2.new(0, mobile and 82 or 113, 0, 0)
    Content.Size = UDim2.new(1, -(mobile and 90 or 121), 1, 0)

    for _, b in ipairs(Sidebar:GetChildren()) do
        if b:IsA("TextButton") then
            b.TextSize = mobile and 10 or 12
        end
    end
end

