-- TOGGLE

function TabAPI:CreateToggle(Config)
    Config = Config or {}

    local Value = Config.CurrentValue == true

    local Container = CreateContainer(44)

    local Name = Make("TextLabel", {
        Position = UDim2.new(0, 10, 0, 0),
        Size = UDim2.new(1, -65, 1, 0),
        BackgroundTransparency = 1,
        Text = Config.Name or "Toggle",
        TextColor3 = C.White,
        TextSize = 12,
        Font = Enum.Font.Gotham,
        TextWrapped = true,
        TextXAlignment = Enum.TextXAlignment.Left
    }, Container)

    local Track = Make("TextButton", {
        AnchorPoint = Vector2.new(1, 0.5),
        Position = UDim2.new(1, -10, 0.5, 0),
        Size = UDim2.fromOffset(38, 21),
        BackgroundColor3 = Value and C.Purple or C.Off,
        BorderSizePixel = 0,
        Text = "",
        AutoButtonColor = false
    }, Container)
    Round(Track, 12)

    local Dot = Make("Frame", {
        Position = Value and UDim2.new(1, -18, 0, 3)
            or UDim2.new(0, 3, 0, 3),
        Size = UDim2.fromOffset(15, 15),
        BackgroundColor3 = C.White,
        BorderSizePixel = 0
    }, Track)
    Round(Dot, 10)

    local function SetValue(NewValue, FireCallback)
        Value = NewValue == true

        TweenService:Create(Track, TweenInfo.new(0.15), {
            BackgroundColor3 = Value and C.Purple or C.Off
        }):Play()

        TweenService:Create(Dot, TweenInfo.new(0.15), {
            Position = Value and UDim2.new(1, -18, 0, 3)
                or UDim2.new(0, 3, 0, 3)
        }):Play()

        if FireCallback ~= false and Config.Callback then
            task.spawn(Config.Callback, Value)
        end
    end

    Track.Activated:Connect(function()
        SetValue(not Value)
    end)

    local API = {}
    function API:Set(NewValue)
        SetValue(NewValue, true)
    end

    function API:Get()
        return Value
    end

    SetValue(Value, false)
    return API
end

-- SLIDER

function TabAPI:CreateSlider(Config)
    Config = Config or {}

    local MinValue = tonumber(Config.Range and Config.Range[1]) or 0
    local MaxValue = tonumber(Config.Range and Config.Range[2]) or 100
    local Value = math.clamp(
        tonumber(Config.CurrentValue) or MinValue,
        MinValue, MaxValue
    )
    local Increment = math.max(tonumber(Config.Increment) or 1, 0.001)

    local Container = CreateContainer(62)

    local Name = Make("TextLabel", {
        Position = UDim2.new(0, 10, 0, 4),
        Size = UDim2.new(0.7, 0, 0, 20),
        BackgroundTransparency = 1,
        Text = Config.Name or "Slider",
        TextColor3 = C.White,
        TextSize = 12,
        Font = Enum.Font.Gotham,
        TextXAlignment = Enum.TextXAlignment.Left
    }, Container)

    local ValueLabel = Make("TextLabel", {
        Position = UDim2.new(0.7, 0, 0, 4),
        Size = UDim2.new(0.3, -10, 0, 20),
        BackgroundTransparency = 1,
        Text = tostring(Value),
        TextColor3 = C.Neon,
        TextSize = 12,
        Font = Enum.Font.GothamBold,
        TextXAlignment = Enum.TextXAlignment.Right
    }, Container)

    local Bar = Make("Frame", {
        Position = UDim2.new(0, 10, 0, 36),
        Size = UDim2.new(1, -20, 0, 7),
        BackgroundColor3 = C.Off,
        BorderSizePixel = 0
    }, Container)
    Round(Bar, 5)

    local Fill = Make("Frame", {
        Size = UDim2.new(
            MaxValue == MinValue and 0 or
                (Value - MinValue) / (MaxValue - MinValue),
            0, 1, 0
        ),
        BackgroundColor3 = C.Purple,
        BorderSizePixel = 0
    }, Bar)
    Round(Fill, 5)

    local Hitbox = Make("TextButton", {
        Position = UDim2.new(0, 0, 0, -10),
        Size = UDim2.new(1, 0, 0, 27),
        BackgroundTransparency = 1,
        Text = "",
        AutoButtonColor = false
    }, Bar)

    local function SetValue(NewValue, FireCallback)
        NewValue = math.clamp(tonumber(NewValue) or MinValue,
            MinValue, MaxValue)

        if MaxValue > MinValue then
            NewValue = MinValue
                + math.floor((NewValue - MinValue) / Increment + 0.5)
                * Increment
        end

        Value = math.clamp(NewValue, MinValue, MaxValue)
        ValueLabel.Text = tostring(Value)

        Fill.Size = UDim2.new(
            MaxValue == MinValue and 0 or
                (Value - MinValue) / (MaxValue - MinValue),
            0, 1, 0
        )

        if FireCallback ~= false and Config.Callback then
            task.spawn(Config.Callback, Value)
        end
    end

    local Sliding = false

    local function UpdateFromX(X)
        local Width = Bar.AbsoluteSize.X
        if Width <= 0 then return end

        local Alpha = math.clamp(
            (X - Bar.AbsolutePosition.X) / Width, 0, 1
        )

        SetValue(MinValue + (MaxValue - MinValue) * Alpha, true)
    end

    Hitbox.Activated:Connect(function()
        UpdateFromX(UIS:GetMouseLocation().X)
    end)

    Hitbox.InputBegan:Connect(function(Input)
        if Input.UserInputType == Enum.UserInputType.MouseButton1
        or Input.UserInputType == Enum.UserInputType.Touch then
            Sliding = true
            UpdateFromX(Input.Position.X)
        end
    end)

    UIS.InputChanged:Connect(function(Input)
        if Sliding and (
            Input.UserInputType == Enum.UserInputType.MouseMovement
            or Input.UserInputType == Enum.UserInputType.Touch
        ) then
            UpdateFromX(Input.Position.X)
        end
    end)

    UIS.InputEnded:Connect(function(Input)
        if Input.UserInputType == Enum.UserInputType.MouseButton1
        or Input.UserInputType == Enum.UserInputType.Touch then
            Sliding = false
        end
    end)

    local API = {}
    function API:Set(NewValue)
        SetValue(NewValue, true)
    end

    function API:Get()
        return Value
    end

    SetValue(Value, false)
    return API
end

