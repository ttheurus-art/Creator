            if typeof(NewKey) == "EnumItem" then
                Key = NewKey
                KeyButton.Text = Key.Name
            end
        end,

        Get = function()
            return Key
        end,

        Destroy = function()
            if InputConnection then
                InputConnection:Disconnect()
            end

            Container:Destroy()
        end,
    }
