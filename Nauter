-- DROPDOWN
function TabMethods:CreateDropdown(config)
    config = config or {}

    local Tab = self
    local Callback = config.Callback or function() end
    local Options = config.Options or {}

    local Multiple = config.MultipleOptions == true
    local CurrentValue

    if Multiple then
        CurrentValue = {}

        if type(config.CurrentOption) == "table" then
            for _, Value in ipairs(config.CurrentOption) do
                table.insert(CurrentValue, Value)
            end
        end
    else
        CurrentValue = config.CurrentOption

        if CurrentValue == nil then
            CurrentValue = Options[1]
        end
    end

    local Expanded = false
    local OptionButtons = {}

    local Container = CreateContainer(
        Tab,
        config.Name or "Dropdown",
        40
    )

    Container.ClipsDescendants = true

    local HeaderButton = Create("TextButton", {
        Name = "DropdownHeader",
        Size = UDim2.new(1, 0, 0, 39),
        BackgroundTransparency = 1,
        BorderSizePixel = 0,
        Text = "",
        AutoButtonColor = false
    }, Container)

    local Title = AddText(
        HeaderButton,
        tostring(config.Name or "Dropdown"),
        12,
        Theme.Text,
        Enum.Font.GothamMedium
    )

    Title.Position = UDim2.new(0, 10, 0, 0)
    Title.Size = UDim2.new(0.55, 0, 1, 0)

    local SelectedText = AddText(
        HeaderButton,
        "",
        11,
        Theme.Purple,
        Enum.Font.GothamMedium
    )

    SelectedText.Name = "Selected"
    SelectedText.TextXAlignment = Enum.TextXAlignment.Right
    SelectedText.Position = UDim2.new(0.48, 0, 0, 0)
    SelectedText.Size = UDim2.new(0.42, -5, 1, 0)

    local Arrow = AddText(
        HeaderButton,
        "v",
        13,
        Theme.SubText,
        Enum.Font.GothamBold
    )

    Arrow.TextXAlignment = Enum.TextXAlignment.Center
    Arrow.Position = UDim2.new(1, -28, 0, 0)
    Arrow.Size = UDim2.fromOffset(20, 39)

    local OptionsFrame = Create("ScrollingFrame", {
        Name = "Options",
        Position = UDim2.new(0, 7, 0, 42),
        Size = UDim2.new(1, -14, 0, 0),
        BackgroundColor3 = Theme.Background,
        BackgroundTransparency = 0.05,
        BorderSizePixel = 0,
        ScrollBarThickness = 3,
        ScrollBarImageColor3 = Theme.Purple,
        CanvasSize = UDim2.new(),
        AutomaticCanvasSize = Enum.AutomaticSize.Y,
        ScrollingDirection = Enum.ScrollingDirection.Y,
        Visible = false
    }, Container)

    AddCorner(OptionsFrame, 7)
    AddPadding(OptionsFrame, 5, 5, 5, 5)
    AddList(OptionsFrame, 4)

    local function IsSelected(Option)
        if Multiple then
            for _, Value in ipairs(CurrentValue) do
                if Value == Option then
                    return true
                end
            end

            return false
        end

        return CurrentValue == Option
    end

    local function RefreshSelectedText()
        if Multiple then
            SelectedText.Text = #CurrentValue > 0
                and table.concat(CurrentValue, ", ")
                or "None"
        else
            SelectedText.Text = tostring(CurrentValue or "None")
        end

        for Option, Button in pairs(OptionButtons) do
            Button.TextColor3 = IsSelected(Option)
                and Theme.Purple
                or Theme.Text
        end
    end

    local function FireCallback()
        local Value

        if Multiple then
            Value = {}

            for _, Option in ipairs(CurrentValue) do
                table.insert(Value, Option)
            end
        else
            Value = CurrentValue
        end

        local Success, ErrorMessage = pcall(
            Callback,
            Value
        )

        if not Success then
            warn("[Nauter Dropdown Error]:", ErrorMessage)
        end
    end

    local function AddOption(Option)
        Option = tostring(Option)

        local Button = Create("TextButton", {
            Name = "Option",
            Size = UDim2.new(1, 0, 0, 29),
            BackgroundColor3 = Theme.PanelLight,
            BackgroundTransparency = 0.1,
            BorderSizePixel = 0,
            AutoButtonColor = false,
            Text = Option,
            TextColor3 = Theme.Text,
            TextSize = 12,
            Font = Enum.Font.Gotham,
            TextXAlignment = Enum.TextXAlignment.Left
        }, OptionsFrame)

        AddCorner(Button, 6)
        AddPadding(Button, 8, 8, 0, 0)

        OptionButtons[Option] = Button

        Button.Activated:Connect(function()
            if Tab.Window.IsDestroyed then
                return
            end

            if Multiple then
                local Found = false

                for Index, Value in ipairs(CurrentValue) do
                    if Value == Option then
                        table.remove(CurrentValue, Index)
                        Found = true
                        break
                    end
                end

                if not Found then
                    table.insert(CurrentValue, Option)
                end
            else
                CurrentValue = Option
                Expanded = false
                OptionsFrame.Visible = false
                Arrow.Text = "v"

                PlayTween(Container, 0.18, {
                    Size = UDim2.new(1, 0, 0, 40)
                })
            end

            RefreshSelectedText()
            FireCallback()
        end)
    end

    for _, Option in ipairs(Options) do
        AddOption(Option)
    end

    local function ToggleExpanded()
        Expanded = not Expanded

        OptionsFrame.Visible = Expanded
        Arrow.Text = Expanded and "^" or "v"

        if Expanded then
            local Count = math.min(#Options, 5)
            local Height = Count * 33 + 10

            PlayTween(Container, 0.2, {
                Size = UDim2.new(1, 0, 0, 48 + Height)
            })

            PlayTween(OptionsFrame, 0.2, {
                Size = UDim2.new(1, -14, 0, Height)
            })
        else
            PlayTween(Container, 0.2, {
                Size = UDim2.new(1, 0, 0, 40)
            })

            PlayTween(OptionsFrame, 0.2, {
                Size = UDim2.new(1, -14, 0, 0)
            })
        end
    end

    HeaderButton.Activated:Connect(ToggleExpanded)

    RefreshSelectedText()

    return {
        Instance = Container,
        Button = HeaderButton,
        Options = OptionsFrame,

        Set = function(_, Value)
            if Multiple then
                CurrentValue = {}

                if type(Value) == "table" then
                    for _, Item in ipairs(Value) do
                        table.insert(CurrentValue, Item)
                    end
                end
            else
                CurrentValue = Value
            end

            RefreshSelectedText()
            FireCallback()
        end,

        Get = function()
            if not Multiple then
                return CurrentValue
            end

            local Copy = {}

            for _, Value in ipairs(CurrentValue) do
                table.insert(Copy, Value)
            end

            return Copy
        end,

        Refresh = function(_, NewOptions)
            Options = NewOptions or {}
            OptionButtons = {}

            for _, Child in ipairs(OptionsFrame:GetChildren()) do
                if Child:IsA("TextButton") then
                    Child:Destroy()
                end
            end

            for _, Option in ipairs(Options) do
                AddOption(Option)
            end

            RefreshSelectedText()
        end
    }
end

