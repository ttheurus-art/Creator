-- BUTTON
function TabMethods:CreateButton(config)
    config = config or {}

    local Tab = self
    local Callback = config.Callback or function() end

    local Container = CreateContainer(
        Tab,
        config.Name or "Button",
        40
    )

    local Button = Create("TextButton", {
        Name = "ActionButton",
        Size = UDim2.fromScale(1, 1),
        BackgroundTransparency = 1,
        BorderSizePixel = 0,
        AutoButtonColor = false,
        Text = tostring(config.Name or "Button"),
        TextColor3 = Theme.Text,
        TextSize = 13,
        Font = Enum.Font.GothamMedium
    }, Container)

    Button.Activated:Connect(function()
        if Tab.Window.IsDestroyed then
            return
        end

        PlayTween(
            Container,
            0.12,
            {BackgroundColor3 = Theme.PurpleDark}
        )

        task.delay(0.15, function()
            if Container.Parent then
                PlayTween(
                    Container,
                    0.12,
                    {BackgroundColor3 = Theme.PanelLight}
                )
            end
        end)

        local Success, ErrorMessage = pcall(Callback)

        if not Success then
            warn("[Nauter Button Error]:", ErrorMessage)
        end
    end)

    return {
        Instance = Container,
        Button = Button,
        SetText = function(_, Text)
            Button.Text = tostring(Text)
        end
    }
end

-- TOGGLE
function TabMethods:CreateToggle(config)
    config = config or {}

    local Tab = self
    local Callback = config.Callback or function() end
    local CurrentValue = config.CurrentValue == true

    local Container = CreateContainer(
        Tab,
        config.Name or "Toggle",
        42
    )

    local Label = AddText(
        Container,
        config.Name or "Toggle",
        13,
        Theme.Text,
        Enum.Font.GothamMedium
    )

    Label.Position = UDim2.new(0, 10, 0, 0)
    Label.Size = UDim2.new(1, -65, 1, 0)

    local Switch = Create("TextButton", {
        Name = "Switch",
        AnchorPoint = Vector2.new(1, 0.5),
        Position = UDim2.new(1, -9, 0.5, 0),
        Size = UDim2.fromOffset(39, 22),
        BackgroundColor3 = CurrentValue
            and Theme.Purple
            or Color3.fromRGB(65, 60, 75),
        BorderSizePixel = 0,
        Text = "",
        AutoButtonColor = false
    }, Container)

    AddCorner(Switch, 11)

    local Knob = Create("Frame", {
        Name = "Knob",
        AnchorPoint = Vector2.new(0, 0.5),
        Position = CurrentValue
            and UDim2.new(1, -19, 0.5, 0)
            or UDim2.new(0, 3, 0.5, 0),
        Size = UDim2.fromOffset(16, 16),
        BackgroundColor3 = Theme.White,
        BorderSizePixel = 0
    }, Switch)

    AddCorner(Knob, 8)

    local function SetValue(Value, FireCallback)
        CurrentValue = Value == true

        PlayTween(Switch, 0.15, {
            BackgroundColor3 = CurrentValue
                and Theme.Purple
                or Color3.fromRGB(65, 60, 75)
        })

        PlayTween(Knob, 0.15, {
            Position = CurrentValue
                and UDim2.new(1, -19, 0.5, 0)
                or UDim2.new(0, 3, 0.5, 0)
        })

        if FireCallback ~= false then
            local Success, ErrorMessage = pcall(
                Callback,
                CurrentValue
            )

            if not Success then
                warn("[Nauter Toggle Error]:", ErrorMessage)
            end
        end
    end

    Switch.Activated:Connect(function()
        if Tab.Window.IsDestroyed then
            return
        end

        SetValue(not CurrentValue, true)
    end)

    local API = {
        Instance = Container,
        Button = Switch,
        Set = function(_, Value)
            SetValue(Value, true)
        end,
        Get = function()
            return CurrentValue
        end
    }

    -- Initialize without firing the callback.
    SetValue(CurrentValue, false)

    return API
end

