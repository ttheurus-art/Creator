    for i, channel in ipairs(channels) do
        local field = Make("TextBox", {
            Position = UDim2.new((i - 1) / 3, (i - 1) * 3, 0, 40),
            Size = UDim2.new(1 / 3, -6, 0, 34),
            BackgroundColor3 = C.BG,
            BorderSizePixel = 0,
            TextColor3 = C.White,
            PlaceholderColor3 = C.Muted,
            PlaceholderText = channel,
            Text = "0",
            ClearTextOnFocus = false,
            TextSize = 12,
            Font = Enum.Font.Gotham,
            TextXAlignment = Enum.TextXAlignment.Center
        }, panel)

        Round(field, 8)
        Stroke(field, C.Purple, 0.65, 1)
        fields[i] = field

        field.FocusLost:Connect(function()
            local n = tonumber(field.Text)

            if not n then
                field.Text = tostring(values[i])
                return
            end

            values[i] = math.clamp(math.floor(n + 0.5), 0, 255)

            local color = Color3.fromRGB(
                values[1], values[2], values[3]
            )

            UpdateRGB(color)

            if callback then callback(currentColor) end
        end)
    end

    local presetButton

    if #colors > 0 then
        presetButton = Make("TextButton", {
            Position = UDim2.new(0, 0, 0, 80),
            Size = UDim2.new(1, 0, 0, 28),
            BackgroundColor3 = C.Panel,
            BorderSizePixel = 0,
            Text = "Next preset color",
            TextColor3 = C.White,
            TextSize = 11,
            Font = Enum.Font.Gotham,
            AutoButtonColor = false
        }, panel)

        Round(presetButton, 8)
        Stroke(presetButton, C.Purple, 0.6, 1)
    end

    local presetIndex = 1

    for i, color in ipairs(colors) do
        if color == currentColor then
            presetIndex = i
            break
        end
    end

    if presetButton then
        presetButton.Activated:Connect(function()
            presetIndex = presetIndex % #colors + 1
            UpdateRGB(colors[presetIndex])

            if callback then callback(currentColor) end
        end)
    end

    local function SetExpanded(state)
        expanded = state
        arrow.Text = expanded and "⌄" or "⌃"
        panel.Visible = expanded

        local panelHeight = presetButton and 112 or 74
        local rootHeight = expanded and (46 + panelHeight) or 42

        TweenService:Create(root, TweenInfo.new(0.18), {
            Size = UDim2.new(1, -4, 0, rootHeight)
        }):Play()

        TweenService:Create(panel, TweenInfo.new(0.18), {
            Size = UDim2.new(1, -16, 0, expanded and panelHeight or 0)
        }):Play()
    end

    header.Activated:Connect(function()
        SetExpanded(not expanded)
    end)

    UpdateRGB(currentColor)

    return root
end

