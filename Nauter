        Size = UDim2.fromOffset(26, 42),
        BackgroundTransparency = 1,
        Text = "⌃",
        TextColor3 = C.Neon,
        TextSize = 20,
        Font = Enum.Font.GothamBold
    }, header)

    local list = Make("ScrollingFrame", {
        Position = UDim2.new(0, 6, 0, 44),
        Size = UDim2.new(1, -12, 0, 0),
        BackgroundColor3 = C.BG,
        BackgroundTransparency = 0.05,
        BorderSizePixel = 0,
        ScrollBarThickness = 3,
        ScrollBarImageColor3 = C.Purple,
        CanvasSize = UDim2.new(),
        AutomaticCanvasSize = Enum.AutomaticSize.Y,
        ScrollingDirection = Enum.ScrollingDirection.Y,
        Visible = false
    }, root)

    Round(list, 8)
    Stroke(list, C.Purple, 0.65, 1)

    Make("UIPadding", {
        PaddingTop = UDim.new(0, 4),
        PaddingBottom = UDim.new(0, 4),
        PaddingLeft = UDim.new(0, 4),
        PaddingRight = UDim.new(0, 4)
    }, list)

    Make("UIListLayout", {
        Padding = UDim.new(0, 4),
        SortOrder = Enum.SortOrder.LayoutOrder
    }, list)

    local expanded = false
    local rowHeight = 32
    local maxListHeight = 150

    local function SetExpanded(state)
        expanded = state
        arrow.Text = expanded and "⌄" or "⌃"

        if expanded and #options > 0 then
            list.Visible = true

            local height = math.min(
                #options * rowHeight + 12,
                maxListHeight
            )

            TweenService:Create(root, TweenInfo.new(0.18), {
                Size = UDim2.new(1, -4, 0, 48 + height)
            }):Play()

            TweenService:Create(list, TweenInfo.new(0.18), {
                Size = UDim2.new(1, -12, 0, height)
            }):Play()
        else
            TweenService:Create(root, TweenInfo.new(0.18), {
                Size = UDim2.new(1, -4, 0, 42)
            }):Play()

            local tween = TweenService:Create(list, TweenInfo.new(0.12), {
                Size = UDim2.new(1, -12, 0, 0)
            })

            tween:Play()
            tween.Completed:Once(function()
                if root.Parent and not expanded then
                    list.Visible = false
                end
            end)
        end
    end

    header.Activated:Connect(function()
        SetExpanded(not expanded)
    end)

    for i, option in ipairs(options) do
        local choice = Make("TextButton", {
            Name = "Option_" .. i,
            Size = UDim2.new(1, 0, 0, rowHeight),
            BackgroundColor3 = option == selected and C.Purple or C.Panel,
            BorderSizePixel = 0,
            Text = tostring(option),
            TextColor3 = C.White,
            TextSize = 12,
            Font = Enum.Font.Gotham,
            TextWrapped = true,
            AutoButtonColor = false,
            LayoutOrder = i
        }, list)

        Round(choice, 7)
        Stroke(choice, C.Purple, 0.8, 1)

        choice.Activated:Connect(function()
            selected = option
            title.Text = tostring(name) .. ": " .. tostring(selected)

            for _, child in ipairs(list:GetChildren()) do
                if child:IsA("TextButton") then
                    child.BackgroundColor3 =
                        child == choice and C.Purple or C.Panel
                end
            end

            SetExpanded(false)

            if callback then
                callback(selected)
            end
        end)
    end

    return root
end

-- KEYBIND

local function AddKeybind(page, name, default, callback)
    local key = default or Enum.KeyCode.RightControl
    local waiting = false
    local connection

    local b
    b = AddButton(page, name .. ": " .. key.Name, function()
        if waiting then return end

        waiting = true
        b.Text = name .. ": ..."

        connection = UIS.InputBegan:Connect(function(input, processed)
            if input.UserInputType ~= Enum.UserInputType.Keyboard then
                return
            end

            if input.KeyCode == Enum.KeyCode.Escape then
                waiting = false
                b.Text = name .. ": " .. key.Name
                connection:Disconnect()
                return
            end

            if processed then return end

            key = input.KeyCode
            waiting = false
            b.Text = name .. ": " .. key.Name
            connection:Disconnect()

            if callback then callback(key) end
        end)
    end)

    b.Destroying:Connect(function()
        if connection and connection.Connected then
            connection:Disconnect()
        end
    end)

    return b
end


