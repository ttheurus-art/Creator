local function AddSection(tab, text)
    local label = Label(tab.Page, string.upper(text), 26, C.Neon)
    label.Font = Enum.Font.GothamBold
    return label
end

-- BUTTON
local function AddButton(tab, name, callback)
    local b = Make("TextButton", {
        Size = UDim2.new(1, -4, 0, 40),
        BackgroundColor3 = C.Panel,
        Text = tostring(name or "Button"),
        TextColor3 = C.White,
        Font = Enum.Font.GothamMedium,
        TextSize = 12,
        AutoButtonColor = false
    }, tab.Page)

    Round(b, 9)
    Outline(b)

    b.Activated:Connect(function()
        TweenService:Create(b, TweenInfo.new(0.1), {
            BackgroundColor3 = C.Purple
        }):Play()

        task.delay(0.15, function()
            if b.Parent then
                b.BackgroundColor3 = C.Panel
            end
        end)

        if callback then callback() end
    end)

    return b
end

function TabAPI:CreateSection(text)
    return AddSection(self, text)
end

function TabAPI:CreateButton(data)
    return AddButton(self, data.Name, data.Callback)
end

-- TOGGLE
function TabAPI:CreateToggle(data)
    local value = data.Default == true
    local box = Card(self, 42)

    local text = Label(box, data.Name, 42)
    text.Position = UDim2.new(0, 10, 0, 0)
    text.Size = UDim2.new(1, -65, 1, 0)

    local switch = Make("Frame", {
        Position = UDim2.new(1, -48, 0.5, -10),
        Size = UDim2.new(0, 36, 0, 20),
        BackgroundColor3 = value and C.Purple or C.Off
    }, box)

    Round(switch, 20)

    local dot = Make("Frame", {
        Position = UDim2.new(0, value and 18 or 2, 0, 2),
        Size = UDim2.new(0, 16, 0, 16),
        BackgroundColor3 = C.White
    }, switch)

    Round(dot, 20)

    local hit = Make("TextButton", {
        Size = UDim2.fromScale(1, 1),
        BackgroundTransparency = 1,
        Text = ""
    }, box)

    hit.Activated:Connect(function()
        value = not value
        switch.BackgroundColor3 = value and C.Purple or C.Off
        dot.Position = UDim2.new(0, value and 18 or 2, 0, 2)

        if data.Callback then
            data.Callback(value)
        end
    end)
end

-- SLIDER
function TabAPI:CreateSlider(data)
    local min = tonumber(data.Min) or 0
    local max = tonumber(data.Max) or 100
    if max <= min then max = min + 1 end

    local value = math.clamp(
        tonumber(data.Default) or min, min, max
    )

    local box = Card(self, 66)

    local label = Label(box, data.Name .. ": " .. value, 24)
    label.Position = UDim2.new(0, 10, 0, 4)

    local bar = Make("Frame", {
        Position = UDim2.new(0, 10, 0, 43),
        Size = UDim2.new(1, -20, 0, 6),
        BackgroundColor3 = C.Off
    }, box)

    Round(bar, 8)

    local fill = Make("Frame", {
        Size = UDim2.new((value - min) / (max - min), 0, 1, 0),
        BackgroundColor3 = C.Purple
    }, bar)

    Round(fill, 8)

    local hit = Make("TextButton", {
        Position = UDim2.new(0, 0, 0, 28),
        Size = UDim2.new(1, 0, 0, 35),
        BackgroundTransparency = 1,
        Text = ""
    }, box)

    local active = false

    local function Set(x)
        local width = bar.AbsoluteSize.X
        if width <= 0 then return end

        value = math.floor(min + math.clamp(
            (x - bar.AbsolutePosition.X) / width, 0, 1
        ) * (max - min) + 0.5)

        fill.Size = UDim2.new(
            (value - min) / (max - min), 0, 1, 0
        )

        label.Text = data.Name .. ": " .. value

        if data.Callback then data.Callback(value) end
    end

    hit.InputBegan:Connect(function(input)
        if input.UserInputType == Enum.UserInputType.MouseButton1
        or input.UserInputType == Enum.UserInputType.Touch then
            active = true
            Set(input.Position.X)
        end
    end)

    UIS.InputChanged:Connect(function(input)
        if active and (
            input.UserInputType == Enum.UserInputType.MouseMovement
            or input.UserInputType == Enum.UserInputType.Touch
        ) then
            Set(input.Position.X)
        end
    end)

    UIS.InputEnded:Connect(function(input)
        if input.UserInputType == Enum.UserInputType.MouseButton1
        or input.UserInputType == Enum.UserInputType.Touch then
            active = false
        end
    end)
end

-- INPUT
function TabAPI:CreateInput(data)
    local box = Card(self, 68)

    local label = Label(box, data.Name, 24)
    label.Position = UDim2.new(0, 10, 0, 2)

    local input = Make("TextBox", {
        Position = UDim2.new(0, 8, 0, 30),
        Size = UDim2.new(1, -16, 0, 30),
        BackgroundColor3 = C.BG,
        TextColor3 = C.White,
        PlaceholderColor3 = C.Muted,
        PlaceholderText = data.Placeholder or "Type here...",
        Text = data.Default or "",
        ClearTextOnFocus = false,
        Font = Enum.Font.Gotham,
        TextSize = 12
    }, box)

    Round(input, 7)

    input.FocusLost:Connect(function(enterPressed)
        if enterPressed and data.Callback then
            data.Callback(input.Text)
        end
    end)
end

-- DROPDOWN
function TabAPI:CreateDropdown(data)
    local options = data.Options or {}
    local index = 1

    for i, option in ipairs(options) do
        if option == data.Default then
            index = i
            break
        end
    end

    local b
    b = AddButton(self,
        data.Name .. ": " .. tostring(options[index] or "Empty"),
        function()
            if #options == 0 then return end

            index = index % #options + 1
            b.Text = data.Name .. ": " .. tostring(options[index])

            if data.Callback then
                data.Callback(options[index])
            end
        end
    )
end

-- KEYBIND
function TabAPI:CreateKeybind(data)
    local key = data.Default or Enum.KeyCode.RightControl
    local b

    b = AddButton(self, data.Name .. ": " .. key.Name, function()
        b.Text = data.Name .. ": Press key"

        local connection
        connection = UIS.InputBegan:Connect(function(input, processed)
            if processed then return end
            if input.UserInputType ~= Enum.UserInputType.Keyboard then
                return
            end

            key = input.KeyCode
            b.Text = data.Name .. ": " .. key.Name
            connection:Disconnect()

            if data.Callback then data.Callback(key) end
        end)
    end)
end

-- COLOR PICKER
function TabAPI:CreateColorPicker(data)
    local colors = data.Colors or {
        C.Purple,
        C.Neon,
        Color3.fromRGB(70, 150, 255),
        Color3.fromRGB(255, 90, 130)
    }

    local index = 1

    for i, color in ipairs(colors) do
        if color == data.Default then
            index = i
            break
        end
    end

    local b
    b = AddButton(self, data.Name or "Color Picker", function()
        if #colors == 0 then return end

        index = index % #colors + 1
        b.BackgroundColor3 = colors[index]

        if data.Callback then
            data.Callback(colors[index])
        end
    end)

    b.BackgroundColor3 = colors[index] or C.Purple
end

