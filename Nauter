local function Make(class, props, parent)
    local obj = Instance.new(class)
    for k, v in pairs(props) do
        obj[k] = v
    end
    obj.Parent = parent
    return obj
end

local function Round(obj, size)
    Make("UICorner", {
        CornerRadius = UDim.new(0, size)
    }, obj)
end

local function Outline(obj, color)
    Make("UIStroke", {
        Color = color,
        Thickness = 1,
        Transparency = 0.25
    }, obj)
end

