-- TAB CREATION
function WindowMethods:CreateTab(config)
    config = config or {}

    local Window = self

    if Window.IsDestroyed then
        error("Cannot create a tab on a destroyed window.")
    end

    local TabName = tostring(config.Name or "Tab")
    local Tab = setmetatable({
        Window = Window,
        Name = TabName,
        Elements = {},
        Order = #Window.Tabs + 1
    }, {
        __index = TabMethods
    })

    -- Tab button
    local TabButton = Create("TextButton", {
        Name = "Tab_" .. TabName,
        Size = UDim2.fromOffset(105, 27),
        BackgroundColor3 = Theme.PanelLight,
        BackgroundTransparency = 0.1,
        BorderSizePixel = 0,
        AutoButtonColor = false,
        Text = TabName,
        TextColor3 = Theme.SubText,
        TextSize = 12,
        Font = Enum.Font.GothamMedium,
        LayoutOrder = Tab.Order
    }, Window.TabBar)

    AddCorner(TabButton, 7)

    local TabStroke = AddStroke(
        TabButton,
        Theme.Border,
        1,
        1
    )

    -- Tab page
    local Page = Create("ScrollingFrame", {
        Name = "Page_" .. TabName,
        Size = UDim2.fromScale(1, 1),
        BackgroundTransparency = 1,
        BorderSizePixel = 0,
        ScrollBarThickness = 3,
        ScrollBarImageColor3 = Theme.Purple,
        CanvasSize = UDim2.new(),
        AutomaticCanvasSize = Enum.AutomaticSize.Y,
        ScrollingDirection = Enum.ScrollingDirection.Y,
        Visible = false
    }, Window.Content)

    AddPadding(Page, 10, 10, 10, 10)

    local ElementLayout = AddList(Page, 8)

    Tab.Button = TabButton
    Tab.Page = Page
    Tab.Layout = ElementLayout

    table.insert(Window.Tabs, Tab)

    -- Select this tab
    local function SelectThisTab()
        if Window.IsDestroyed then
            return
        end

        Window.SelectedTab = Tab

        for _, ExistingTab in ipairs(Window.Tabs) do
            local Selected = ExistingTab == Tab

            ExistingTab.Page.Visible = Selected

            PlayTween(
                ExistingTab.Button,
                0.15,
                {
                    BackgroundColor3 = Selected
                        and Theme.PurpleDark
                        or Theme.PanelLight,

                    BackgroundTransparency = Selected
                        and 0
                        or 0.1,

                    TextColor3 = Selected
                        and Theme.White
                        or Theme.SubText
                }
            )

            ExistingTab.Stroke.Transparency = Selected and 0 or 1
        end
    end

    Tab.Select = SelectThisTab
    Tab.Stroke = TabStroke

    table.insert(Window.Connections, TabButton.Activated:Connect(
        SelectThisTab
    ))

    if #Window.Tabs == 1 then
        SelectThisTab()
    end

    return Tab
end

-- SELECT TAB BY NAME
function WindowMethods:SelectTab(Name)
    for _, Tab in ipairs(self.Tabs) do
        if Tab.Name == Name then
            Tab.Select()
            return true
        end
    end

    return false
end

