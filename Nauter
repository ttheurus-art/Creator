function Nauter:CreateWindow(config)
    config = config or {}

    local PlayerGui = LocalPlayer:WaitForChild("PlayerGui")

    -- Remove the previous Nauter GUI.
    local OldGui = PlayerGui:FindFirstChild("Nauter")

    if OldGui then
        OldGui:Destroy()
    end

    local ScreenGui = Create("ScreenGui", {
        Name = "Nauter",
        ResetOnSpawn = false,
        IgnoreGuiInset = true,
        ZIndexBehavior = Enum.ZIndexBehavior.Sibling,
        DisplayOrder = 100
    }, PlayerGui)

    local Window = setmetatable({
        Gui = ScreenGui,
        Connections = {},
        Tabs = {},
        SelectedTab = nil,
        IsMinimized = false,
        IsDestroyed = false,
        Name = config.Name or "Nauter",
        Notifications = {},
        _NotificationCount = 0
    }, {
        __index = WindowMethods
    })

    -- Main window.
local Main = Create("Frame", {
    Name = "Main",
    AnchorPoint = Vector2.new(0.5, 0.5),
    Position = UDim2.fromScale(0.5, 0.5),
    Size = UDim2.new(0, 650, 0, 370),
    BackgroundColor3 = Theme.Background,
    BackgroundTransparency = 0.1,
    BorderSizePixel = 0,
    ClipsDescendants = true
}, ScreenGui)

    Window.Main = Main

    AddCorner(Main, 14)
    AddStroke(Main, Theme.Border, 1.4, 0.1)
    AddGradient(Main)

    -- Responsive scaling.
    local Scale = Create("UIScale", {
        Scale = 1
    }, Main)

    Window.Scale = Scale

    local function UpdateScale()
        local Camera = workspace.CurrentCamera

        if not Camera then
            return
        end

        local Viewport = Camera.ViewportSize
        local ShortSide = math.min(Viewport.X, Viewport.Y)

        if ShortSide < 500 then
            Scale.Scale = 0.76
        elseif ShortSide < 750 then
            Scale.Scale = 0.88
        else
            Scale.Scale = 1
        end
    end

    UpdateScale()

    if workspace.CurrentCamera then
        table.insert(Window.Connections,
            workspace.CurrentCamera:GetPropertyChangedSignal(
                "ViewportSize"
            ):Connect(UpdateScale)
        )
    end

    -- Header.
    local Header = Create("Frame", {
        Name = "Header",
        Size = UDim2.new(1, 0, 0, 43),
        BackgroundColor3 = Theme.Background,
        BackgroundTransparency = 0.05,
        BorderSizePixel = 0,
        ZIndex = 2
    }, Main)

    Window.Header = Header

    AddCorner(Header, 14)

    -- Cover lower header corners.
    Create("Frame", {
        Name = "HeaderBottomCover",
        Position = UDim2.new(0, 0, 1, -14),
        Size = UDim2.new(1, 0, 0, 14),
        BackgroundColor3 = Theme.Background,
        BackgroundTransparency = 0.05,
        BorderSizePixel = 0,
        ZIndex = 2
    }, Header)

    local HeaderTitle = AddText(
        Header,
        Window.Name,
        18,
        Theme.Text,
        Enum.Font.GothamBold
    )

    HeaderTitle.Name = "Title"
    HeaderTitle.Position = UDim2.new(0, 14, 0, 0)
    HeaderTitle.Size = UDim2.new(1, -100, 1, 0)
    HeaderTitle.ZIndex = 3

    Window.TitleLabel = HeaderTitle

    -- Minimize button.
    local MinimizeButton = Create("TextButton", {
        Name = "Minimize",
        Position = UDim2.new(1, -68, 0, 7),
        Size = UDim2.fromOffset(26, 27),
        BackgroundColor3 = Theme.PanelLight,
        BorderSizePixel = 0,
        AutoButtonColor = false,
        Text = "-",
        TextSize = 22,
        TextColor3 = Theme.Text,
        Font = Enum.Font.GothamBold,
        ZIndex = 4
    }, Header)

    AddCorner(MinimizeButton, 8)

    -- Close button.
    local CloseButton = Create("TextButton", {
        Name = "Close",
        Position = UDim2.new(1, -35, 0, 7),
        Size = UDim2.fromOffset(26, 27),
        BackgroundColor3 = Color3.fromRGB(100, 35, 58),
        BorderSizePixel = 0,
        AutoButtonColor = false,
        Text = "x",
        TextSize = 15,
        TextColor3 = Theme.White,
        Font = Enum.Font.GothamBold,
        ZIndex = 4
    }, Header)

    AddCorner(CloseButton, 8)

    Window.MinimizeButton = MinimizeButton
    Window.CloseButton = CloseButton

    -- Tab navigation.
    local TabBar = Create("ScrollingFrame", {
    Name = "TabBar",
    Position = UDim2.new(0, 10, 0, 52),
    Size = UDim2.new(1, -20, 0, 35),
    BackgroundColor3 = Theme.Panel,
    BackgroundTransparency = 0.15,
    BorderSizePixel = 0,
    ScrollBarThickness = 2,
    ScrollBarImageColor3 = Theme.Purple,
    ScrollingDirection = Enum.ScrollingDirection.X,
    CanvasSize = UDim2.new(0, 0, 0, 0),
    AutomaticCanvasSize = Enum.AutomaticSize.X
}, Main)

    AddCorner(TabBar, 9)

    local TabLayout = Create("UIListLayout", {
        FillDirection = Enum.FillDirection.Horizontal,
        SortOrder = Enum.SortOrder.LayoutOrder,
        Padding = UDim.new(0, 5)
    }, TabBar)

    AddPadding(TabBar, 5, 5, 4, 4)

    Window.TabBar = TabBar
    Window.TabLayout = TabLayout

    -- Content area.
    local Content = Create("Frame", {
        Name = "Content",
        Position = UDim2.new(0, 10, 0, 96),
        Size = UDim2.new(1, -20, 1, -106),
        BackgroundColor3 = Theme.Panel,
        BackgroundTransparency = 0.13,
        BorderSizePixel = 0,
        ClipsDescendants = true
    }, Main)

    AddCorner(Content, 11)
    AddStroke(Content, Theme.Border, 1, 0.65)

    Window.Content = Content

    -- Floating restore button.
    local FloatingButton = Create("TextButton", {
        Name = "NauterRestore",
        AnchorPoint = Vector2.new(0, 0),
        Position = UDim2.new(0, 15, 0.5, -25),
        Size = UDim2.fromOffset(50, 50),
        BackgroundColor3 = Theme.PurpleDark,
        BackgroundTransparency = 0.05,
        BorderSizePixel = 0,
        Text = "N",
        TextColor3 = Theme.White,
        TextSize = 23,
        Font = Enum.Font.GothamBold,
        Visible = false,
        ZIndex = 20
    }, ScreenGui)

    AddCorner(FloatingButton, 25)
    AddStroke(FloatingButton, Theme.Purple, 1.5, 0)

    Window.FloatingButton = FloatingButton

    -- Save the original window dimensions.
    local NormalSize = Main.Size
    local NormalPosition = Main.Position

    -- Drag window using its header.
    ConnectDrag(Header, Main, Window.Connections)

    -- Minimize animation.
    table.insert(Window.Connections, MinimizeButton.Activated:Connect(function()
        if Window.IsMinimized or Window.IsDestroyed then
            return
        end

        Window.IsMinimized = true
        NormalSize = Main.Size
        NormalPosition = Main.Position

        PlayTween(Main, 0.25, {
            Size = UDim2.fromOffset(0, 0),
            BackgroundTransparency = 1
        })

        task.delay(0.26, function()
            if Window.IsDestroyed then
                return
            end

            Main.Visible = false
            Main.Size = NormalSize
            Main.BackgroundTransparency = 0.1
            FloatingButton.Visible = true
        end)
    end))

    -- Restore window.
    table.insert(Window.Connections, FloatingButton.Activated:Connect(function()
        if Window.IsDestroyed then
            return
        end

        Window.IsMinimized = false
        FloatingButton.Visible = false

        Main.Visible = true
        Main.Size = UDim2.fromOffset(0, 0)
        Main.Position = NormalPosition

        PlayTween(Main, 0.3, {
            Size = NormalSize,
            BackgroundTransparency = 0.1
        })
    end))

    -- Close window
CloseButton.Activated:Connect(function()
    ScreenGui:Destroy()
end)

    -- Hover effects.
    for _, Button in ipairs({MinimizeButton, CloseButton}) do
        table.insert(Window.Connections, Button.MouseEnter:Connect(function()
            if Button == CloseButton then
                Button.BackgroundColor3 = Theme.Red
            else
                Button.BackgroundColor3 = Theme.PurpleDark
            end
        end))

        table.insert(Window.Connections, Button.MouseLeave:Connect(function()
            if Button == CloseButton then
                Button.BackgroundColor3 = Color3.fromRGB(100, 35, 58)
            else
                Button.BackgroundColor3 = Theme.PanelLight
            end
        end))
    end

    return Window
end

