    }, HeaderButton)
    Round(Preview, 6)
    Stroke(Preview, C.Neon, 0.2, 1)

    local Arrow = Make("TextLabel", {
        AnchorPoint = Vector2.new(1, 0.5),
        Position = UDim2.new(1, -5, 0.5, 0),
        Size = UDim2.fromOffset(16, 22),
        BackgroundTransparency = 1,
        Text = "v",
        TextColor3 = C.Neon,
        TextSize = 12,
        Font = Enum.Font.GothamBold
    }, HeaderButton)

    local Picker = Make("Frame", {
        Position = UDim2.new(0, 4, 0, 44),
        Size = UDim2.new(1, -8, 0, 86),
        BackgroundColor3 = C.Panel,
        BorderSizePixel = 0,
        Visible = false
    }, Container)
    Round(Picker, 7)

    local RGBBox = Make("TextBox", {
        Position = UDim2.new(0, 7, 0, 7),
        Size = UDim2.new(1, -14, 0, 29),
        BackgroundColor3 = C.BG,
        BorderSizePixel = 0,
        Text = "",
        PlaceholderText = "R, G, B  (contoh: 233, 100, 77)",
        PlaceholderColor3 = C.Muted,
        TextColor3 = C.White,
        TextSize = 10,
        Font = Enum.Font.Gotham,
        ClearTextOnFocus = false
    }, Picker)
    Round(RGBBox, 6)

    local Apply = Make("TextButton", {
        Position = UDim2.new(0, 7, 0, 43),
        Size = UDim2.new(1, -14, 0, 30),
        BackgroundColor3 = C.Purple,
        BorderSizePixel = 0,
        Text = "Apply RGB",
        TextColor3 = C.White,
        TextSize = 11,
        Font = Enum.Font.GothamBold,
        AutoButtonColor = false
    }, Picker)
    Round(Apply, 6)

    local function SetColor(Color, FireCallback)
        CurrentColor = Color
        Preview.BackgroundColor3 = Color

        if FireCallback ~= false and Config.Callback then
            task.spawn(Config.Callback, Color)
        end
    end

    HeaderButton.Activated:Connect(function()
        Open = not Open
        Picker.Visible = Open
        Arrow.Text = Open and "^" or "v"
        Container.Size = UDim2.new(1, 0, 0, Open and 138 or 44)
    end)

    Apply.Activated:Connect(function()
        local R, G, B = RGBBox.Text:match(
            "^%s*(%d+)%s*,%s*(%d+)%s*,%s*(%d+)%s*$"
        )

        R, G, B = tonumber(R), tonumber(G), tonumber(B)

        if R and G and B
        and R >= 0 and R <= 255
        and G >= 0 and G <= 255
        and B >= 0 and B <= 255 then
            SetColor(Color3.fromRGB(R, G, B), true)
        else
            RGBBox.Text = ""
            RGBBox.PlaceholderText = "Format salah! Contoh: 233, 100, 77"
        end
    end)

    local API = {}

    function API:Set(Color)
        if typeof(Color) == "Color3" then
            SetColor(Color, true)
        end
    end

    function API:Get()
        return CurrentColor
    end

    SetColor(CurrentColor, false)
    return API
end

-- NOTIFICATION
-- Letakkan bagian ini di dalam Window:CreateWindow(),
-- setelah function Window:Destroy() dan sebelum Window.Name.

function Window:Notify(Config)
    Config = Config or {}

    local Text = tostring(Config.Content or Config.Message or "")
    local Duration = tonumber(Config.Duration) or 3

    local Note = Make("Frame", {
        AnchorPoint = Vector2.new(1, 1),
        Position = UDim2.new(1, -12, 1, -12),
        Size = UDim2.fromOffset(140, 48),
        BackgroundColor3 = C.Panel,
        BackgroundTransparency = 0.05,
        BorderSizePixel = 0,
        ClipsDescendants = true,
        ZIndex = 80
    }, Gui)
    Round(Note, 9)
    Stroke(Note, C.Purple, 0.05, 1.5)

    local NoteTitle = Make("TextLabel", {
        Position = UDim2.new(0, 8, 0, 4),
        Size = UDim2.new(1, -16, 0, 15),
        BackgroundTransparency = 1,
        Text = tostring(Config.Title or "NAUTER"),
        TextColor3 = C.Neon,
        TextSize = 10,
        Font = Enum.Font.GothamBold,
        TextXAlignment = Enum.TextXAlignment.Left,
        ZIndex = 81
    }, Note)

    local NoteContent = Make("TextLabel", {
        Position = UDim2.new(0, 8, 0, 19),
        Size = UDim2.new(1, -16, 0, 20),
        BackgroundTransparency = 1,
        Text = Text,
        TextColor3 = C.White,
        TextSize = 9,
        Font = Enum.Font.Gotham,
        TextWrapped = true,
        TextXAlignment = Enum.TextXAlignment.Left,
        ZIndex = 81
    }, Note)

    local TimerBack = Make("Frame", {
        AnchorPoint = Vector2.new(0, 1),
        Position = UDim2.new(0, 0, 1, 0),
        Size = UDim2.new(1, 0, 0, 3),
        BackgroundColor3 = C.Off,
        BorderSizePixel = 0,
        ZIndex = 82
    }, Note)

    local Timer = Make("Frame", {
        Size = UDim2.fromScale(1, 1),
        BackgroundColor3 = C.Purple,
        BorderSizePixel = 0,
        ZIndex = 83
    }, TimerBack)

    TweenService:Create(
        Timer,
        TweenInfo.new(math.max(Duration, 0.1), Enum.EasingStyle.Linear),
        {Size = UDim2.new(0, 0, 1, 0)}
    ):Play()

    task.delay(math.max(Duration, 0.1), function()
        if Note.Parent then
            local Tween = TweenService:Create(
                Note,
                TweenInfo.new(0.2, Enum.EasingStyle.Quad),
                {
                    Position = Note.Position + UDim2.fromOffset(20, 0),
                    BackgroundTransparency = 1
                }
            )
            Tween:Play()
            Tween.Completed:Wait()

            if Note.Parent then
                Note:Destroy()
            end
        end
    end)

    return Note
end

