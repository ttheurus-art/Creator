    }, HeaderButton)

    local Preview = Make("Frame", {
        AnchorPoint = Vector2.new(1, 0.5),
        Position = UDim2.new(1, -28, 0.5, 0),
        Size = UDim2.fromOffset(22, 22),
        BackgroundColor3 = CurrentColor,
