        Position = UDim2.new(0, 14, 0, 0),
        Size = UDim2.new(0.55, 0, 1, 0),
        Font = Enum.Font.GothamSemibold,
        Text = config.Name or "Dropdown",
        TextColor3 = Theme.Text,
        TextSize = 13,
        TextXAlignment = Enum.TextXAlignment.Left,
    })

    local SelectedLabel = Create("TextLabel", {
        Parent = Header,
        BackgroundTransparency = 1,
        Position = UDim2.new(0.48, 0, 0, 0),
        Size = UDim2.new(0.35, 0, 1, 0),
        Font = Enum.Font.Gotham,
        Text = "",
        TextColor3 = Theme.Muted,
        TextSize = 11,
        TextTruncate = Enum.TextTruncate.AtEnd,
        TextXAlignment = Enum.TextXAlignment.Right,
    })

    local Arrow = Create("TextLabel", {
        Parent = Header,
        BackgroundTransparency = 1,
        Position = UDim2.new(1, -34, 0, 0),
        Size = UDim2.new(0, 22, 1, 0),
        Font = Enum.Font.GothamBold,
        Text = "v",
        TextColor3 = Theme.Accent,
        TextSize = 15,
    })

    local OptionsFrame = Create("ScrollingFrame", {
        Parent = Container,
        Position = UDim2.new(0, 8, 0, 48),
        Size = UDim2.new(1, -16, 0, 0),
        BackgroundTransparency = 1,
        BorderSizePixel = 0,
        ScrollBarThickness = 3,
        ScrollBarImageColor3 = Theme.Accent,
        CanvasSize = UDim2.new(0, 0, 0, 0),
        Visible = false,
    })

    local OptionList = Create("UIListLayout", {
        Parent = OptionsFrame,
        Padding = UDim.new(0, 5),
        SortOrder = Enum.SortOrder.LayoutOrder,
    })

    OptionList:GetPropertyChangedSignal("AbsoluteContentSize"):Connect(function()
        OptionsFrame.CanvasSize = UDim2.new(
            0,
            0,
            0,
            OptionList.AbsoluteContentSize.Y + 5
        )
    end)

    local Open = false

    local function RefreshSelected()
        local Result = {}

        for _, Option in ipairs(Options) do
            if Selected[Option] then
                table.insert(Result, tostring(Option))
            end
        end

        SelectedLabel.Text = table.concat(Result, ", ")
    end

    local function NotifySelection()
        local Result = {}

        for _, Option in ipairs(Options) do
            if Selected[Option] then
                table.insert(Result, Option)
            end
        end

        if config.Callback then
            task.spawn(
                config.Callback,
                Multiple and Result or Result[1]
            )
        end
    end

    local function RefreshOptions()
        for _, Child in ipairs(OptionsFrame:GetChildren()) do
            if Child:IsA("TextButton") then
                Child:Destroy()
            end
        end

        for _, Option in ipairs(Options) do
            local OptionButton = Create("TextButton", {
                Parent = OptionsFrame,
                BackgroundColor3 = Selected[Option]
                    and Theme.Accent
                    or Theme.Secondary,
                BackgroundTransparency = 0.1,
                BorderSizePixel = 0,
                Size = UDim2.new(1, -4, 0, 34),
                Font = Enum.Font.Gotham,
                Text = "  " .. tostring(Option),
                TextColor3 = Theme.Text,
                TextSize = 12,
                TextXAlignment = Enum.TextXAlignment.Left,
                AutoButtonColor = false,
            })

            Create("UICorner", {
                Parent = OptionButton,
                CornerRadius = UDim.new(0, 8),
            })

            OptionButton.MouseButton1Click:Connect(function()
                if Multiple then
                    Selected[Option] = not Selected[Option]
                else
                    table.clear(Selected)
                    Selected[Option] = true
                    Open = false

                    OptionsFrame.Visible = false
                    Container.Size = UDim2.new(1, 0, 0, 48)

                    TweenService:Create(
                        Arrow,
                        TweenInfo.new(0.15),
                        {Rotation = 0}
                    ):Play()
                end

                RefreshSelected()
                RefreshOptions()
                NotifySelection()
            end)
        end
    end

    local function ToggleDropdown()
        Open = not Open

        OptionsFrame.Visible = Open

        local Height = Open and math.min(#Options * 39 + 5, 156) or 0

        TweenService:Create(
            Container,
            TweenInfo.new(0.2, Enum.EasingStyle.Quad, Enum.EasingDirection.Out),
            {
                Size = UDim2.new(1, 0, 0, 48 + Height),
            }
        ):Play()

        TweenService:Create(
            Arrow,
            TweenInfo.new(0.2),
            {Rotation = Open and 180 or 0}
        ):Play()

        OptionsFrame.Size = UDim2.new(1, -16, 0, Height)
    end

    Header.MouseButton1Click:Connect(ToggleDropdown)

    RefreshSelected()
    RefreshOptions()

    return {
        Set = function(_, NewOptions)
            if typeof(NewOptions) == "table" then
                Options = NewOptions
                table.clear(Selected)
                RefreshSelected()
                RefreshOptions()
            end
        end,

        Get = function()
            local Result = {}

            for _, Option in ipairs(Options) do
                if Selected[Option] then
                    table.insert(Result, Option)
                end
            end

            return Multiple and Result or Result[1]
        end,
    }
end

