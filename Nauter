local function Button(text, callback)
    local b = Make("TextButton", {
        Size = UDim2.new(1, -4, 0, 42),
        BackgroundColor3 = C.Panel,
        Text = text,
        TextColor3 = C.White,
        Font = Enum.Font.GothamMedium,
        TextSize = 13,
        AutoButtonColor = false
    }, Content)

    Round(b, 9)
    Outline(b, C.Purple)

    b.Activated:Connect(function()
        TweenService:Create(b, TweenInfo.new(0.12), {
            BackgroundColor3 = C.Purple
        }):Play()

        task.delay(0.15, function()
            if b.Parent then
                b.BackgroundColor3 = C.Panel
            end
        end)

        if callback then callback() end
    end)

    return b
end

local function Toggle(text, default, callback)
    local value = default == true

    local b = Make("TextButton", {
        Size = UDim2.new(1, -4, 0, 44),
        BackgroundColor3 = C.Panel,
        Text = "",
        AutoButtonColor = false
    }, Content)
    Round(b, 9)

    Make("TextLabel", {
        Position = UDim2.new(0, 10, 0, 0),
        Size = UDim2.new(1, -65, 1, 0),
        BackgroundTransparency = 1,
        Text = text,
        TextColor3 = C.White,
        Font = Enum.Font.GothamMedium,
        TextSize = 12,
        TextXAlignment = Enum.TextXAlignment.Left
    }, b)

    local switch = Make("Frame", {
        Position = UDim2.new(1, -49, 0.5, -10),
        Size = UDim2.new(0, 38, 0, 20),
        BackgroundColor3 = value and C.Purple or C.Off
    }, b)
    Round(switch, 20)

    local dot = Make("Frame", {
        Position = value and UDim2.new(1, -18, 0, 2)
            or UDim2.new(0, 2, 0, 2),
        Size = UDim2.new(0, 16, 0, 16),
        BackgroundColor3 = C.White
    }, switch)
    Round(dot, 20)

    b.Activated:Connect(function()
        value = not value
        switch.BackgroundColor3 = value and C.Purple or C.Off
        dot.Position = value and UDim2.new(1, -18, 0, 2)
            or UDim2.new(0, 2, 0, 2)

        if callback then callback(value) end
    end)
end

local function Slider(text, min, max, default, callback)
    local value = default

    local box = Make("Frame", {
        Size = UDim2.new(1, -4, 0, 65),
        BackgroundColor3 = C.Panel
    }, Content)
    Round(box, 9)

    local label = Make("TextLabel", {
        Position = UDim2.new(0, 10, 0, 5),
        Size = UDim2.new(1, -20, 0, 22),
        BackgroundTransparency = 1,
        Text = text .. ": " .. value,
        TextColor3 = C.White,
        Font = Enum.Font.GothamMedium,
        TextSize = 12,
        TextXAlignment = Enum.TextXAlignment.Left
    }, box)

    local bar = Make("Frame", {
        Position = UDim2.new(0, 10, 0, 40),
        Size = UDim2.new(1, -20, 0, 6),
        BackgroundColor3 = C.Off
    }, box)
    Round(bar, 8)

    local fill = Make("Frame", {
        Size = UDim2.new((value-min)/(max-min), 0, 1, 0),
        BackgroundColor3 = C.Purple
    }, bar)
    Round(fill, 8)

    local hit = Make("TextButton", {
        Position = UDim2.new(0, 0, 0, 28),
        Size = UDim2.new(1, 0, 0, 32),
        BackgroundTransparency = 1,
        Text = ""
    }, box)

    local function Set(x)
        local width = bar.AbsoluteSize.X
        if width <= 0 then return end

        value = math.floor(min + math.clamp(
            (x - bar.AbsolutePosition.X) / width, 0, 1
        ) * (max-min) + 0.5)

        fill.Size = UDim2.new((value-min)/(max-min), 0, 1, 0)
        label.Text = text .. ": " .. value

        if callback then callback(value) end
    end

    local active = false

    hit.InputBegan:Connect(function(input)
        if input.UserInputType == Enum.UserInputType.Touch
        or input.UserInputType == Enum.UserInputType.MouseButton1 then
            active = true
            Set(input.Position.X)
        end
    end)

    UIS.InputChanged:Connect(function(input)
        if active and (
            input.UserInputType == Enum.UserInputType.Touch
            or input.UserInputType == Enum.UserInputType.MouseMovement
        ) then
            Set(input.Position.X)
        end
    end)

    UIS.InputEnded:Connect(function(input)
        if input.UserInputType == Enum.UserInputType.Touch
        or input.UserInputType == Enum.UserInputType.MouseButton1 then
            active = false
        end
    end)
end

