-- WINDOW API
function WindowAPI:CreateTab(name)
    TabCount += 1

    local tab = setmetatable({
        Name = tostring(name or ("Tab " .. TabCount)),
        Page = NewPage()
    }, {__index = TabAPI})

    local button = Make("TextButton", {
        Name = "Tab_" .. TabCount,
        Size = UDim2.new(1, 0, 0, 36),
        BackgroundColor3 = C.Panel,
        Text = tab.Name,
        TextColor3 = C.White,
        Font = Enum.Font.GothamBold,
        TextSize = 11,
        TextWrapped = true,
        LayoutOrder = TabCount
    }, Sidebar)

    Round(button, 8)

    button.Activated:Connect(function()
        if CurrentTab then
            CurrentTab.Page.Visible = false
        end

        CurrentTab = tab
        tab.Page.Visible = true

        for _, child in ipairs(Sidebar:GetChildren()) do
            if child:IsA("TextButton") then
                child.BackgroundColor3 =
                    child == button and C.Purple or C.Panel
            end
        end

        tab.Page.CanvasPosition = Vector2.new(0, 0)
    end)

    if TabCount == 1 then
        button.BackgroundColor3 = C.Purple
        CurrentTab = tab
        tab.Page.Visible = true
    end

    return tab
end

-- CREATE WINDOW
function Nauter:CreateWindow(data)
    Title.Text = tostring(data.Name or "NAUTER")
    return setmetatable({}, {__index = WindowAPI})
end

-- NOTIFICATION
function Nauter:Notify(data)
    local toast = Make("Frame", {
        AnchorPoint = Vector2.new(1, 0),
        Position = UDim2.new(1, -12, 0, 12),
        Size = UDim2.new(0.65, 0, 0, 76),
        BackgroundColor3 = C.Panel,
        BackgroundTransparency = 0.05,
        BorderSizePixel = 0,
        ZIndex = 20
    }, Gui)

    Round(toast, 10)
    Outline(toast)

    local title = Label(toast, data.Title or "Nauter", 25, C.Neon)
    title.Position = UDim2.new(0, 10, 0, 5)
    title.ZIndex = 21

    local message = Label(toast, data.Content or "", 38, C.White)
    message.Position = UDim2.new(0, 10, 0, 32)
    message.Size = UDim2.new(1, -20, 0, 38)
    message.ZIndex = 21

    task.delay(data.Duration or 3, function()
        if toast.Parent then toast:Destroy() end
    end)
end

function Nauter:Destroy()
    Gui:Destroy()
end

function Nauter:SetVisible(state)
    Main.Visible = state == true
    MiniN.Visible = false
end

function Nauter:GetGui()
    return Gui
end

return Nauter
