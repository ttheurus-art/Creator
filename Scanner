-- SCANNER
local Remotes = {}
local scanning = false
local AUTO_SCAN_INTERVAL = 0.01

local function Scan()
    if scanning or destroyed then
        return false
    end

    scanning = true

    local NewRemotes = {}
    local ok, err = pcall(function()
        for _, obj in ipairs(ReplicatedStorage:GetDescendants()) do
            if obj:IsA("RemoteEvent")
                or obj:IsA("RemoteFunction") then

                table.insert(NewRemotes, {
                    Object = obj,
                    Name = obj.Name,
                    Type = obj.ClassName,
                    Path = obj:GetFullName()
                })
            end
        end
    end)

    scanning = false

    if not ok then
        Status.Text = "Scan failed: " .. tostring(err)
        return false
    end

    table.sort(NewRemotes, function(a, b)
        return a.Path:lower() < b.Path:lower()
    end)

    Remotes = NewRemotes
    return true
end

-- GENERATE CODE
local function BuildCode(info)
    local obj = info.Object

    if not obj or not obj:IsDescendantOf(ReplicatedStorage) then
        return nil
    end

    local parts = {}
    local current = obj

    while current and current ~= ReplicatedStorage do
        table.insert(parts, 1, current.Name)
        current = current.Parent
    end

    local code = 'local Event = game:GetService("ReplicatedStorage")'

    for _, part in ipairs(parts) do
        local escaped = part:gsub("\\", "\\\\"):gsub('"', '\\"')
        code ..= ':FindFirstChild("' .. escaped .. '")'
    end

    if info.Type == "RemoteEvent" then
        code ..= '\n\n-- Replace these sample arguments with the documented arguments.\nEvent:FireServer(false, false)'
    else
        code ..= '\n\n-- RemoteFunction: check its expected arguments before InvokeServer.'
    end

    return code
end

-- RENDER LIST
local function Render()
    if destroyed or not Gui.Parent then
        return
    end

    for _, child in ipairs(List:GetChildren()) do
        if child ~= Layout and not child:IsA("UIPadding") then
            child:Destroy()
        end
    end

    local query = Search.Text:lower()
    local shown = 0

    for _, info in ipairs(Remotes) do
        local matches =
            info.Name:lower():find(query, 1, true)
            or info.Path:lower():find(query, 1, true)
            or info.Type:lower():find(query, 1, true)

        if matches and info.Object.Parent then
            shown += 1

            local Row = Create("Frame", {
                Name = "RemoteRow",
                Size = UDim2.new(1, -2, 0, 78),
                BackgroundColor3 = Theme.Row,
                BorderSizePixel = 0,
                LayoutOrder = shown
            }, List)

            Corner(Row, 7)

            Create("TextLabel", {
                Position = UDim2.new(0, 10, 0, 5),
                Size = UDim2.new(1, -108, 0, 23),
                BackgroundTransparency = 1,
                Text = info.Name,
                TextColor3 = Theme.Text,
                TextSize = 12,
                Font = Enum.Font.GothamBold,
                TextXAlignment = Enum.TextXAlignment.Left,
                TextTruncate = Enum.TextTruncate.AtEnd
            }, Row)

            Create("TextLabel", {
                Position = UDim2.new(0, 10, 0, 29),
                Size = UDim2.new(1, -18, 0, 39),
                BackgroundTransparency = 1,
                Text = info.Type .. "\n" .. info.Path,
                TextColor3 = Theme.SubText,
                TextSize = 9,
                Font = Enum.Font.Gotham,
                TextXAlignment = Enum.TextXAlignment.Left,
                TextYAlignment = Enum.TextYAlignment.Top,
                TextWrapped = false,
                TextTruncate = Enum.TextTruncate.AtEnd
            }, Row)

            local Copy = Create("TextButton", {
                Position = UDim2.new(1, -94, 0, 7),
                Size = UDim2.new(0, 86, 0, 28),
                BackgroundColor3 = Theme.Button,
                Text = "COPY CODE",
                TextColor3 = Theme.Text,
                TextSize = 10,
                Font = Enum.Font.GothamBold,
                BorderSizePixel = 0
            }, Row)

            Corner(Copy, 6)
            Stroke(Copy, Theme.Border)

            Copy.MouseButton1Click:Connect(function()
                local code = BuildCode(info)

                if not code then
                    Status.Text = "Remote no longer exists"
                    return
                end

                if typeof(setclipboard) == "function" then
                    local ok = pcall(setclipboard, code)

                    if ok then
                        Status.Text = "Copied: " .. info.Name
                        Status.TextColor3 = Theme.Green
                    else
                        Status.Text = "Clipboard unavailable"
                        Status.TextColor3 = Theme.SubText
                    end
                else
                    Status.Text = "Clipboard unavailable"
                    Status.TextColor3 = Theme.SubText
                end
            end)
        end
    end

    Status.Text = string.format(
        "%d remotes found | %d shown",
        #Remotes,
        shown
    )
    Status.TextColor3 = Theme.SubText
end

