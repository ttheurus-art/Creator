-- SCAN
local Remotes = {}
local scanning = false

local function Scan()
    if scanning then
        return
    end

    scanning = true
    table.clear(Remotes)

    for _, obj in ipairs(ReplicatedStorage:GetDescendants()) do
        if obj:IsA("RemoteEvent")
            or obj:IsA("RemoteFunction") then

            table.insert(Remotes, {
                Object = obj,
                Name = obj.Name,
                Type = obj.ClassName,
                Path = obj:GetFullName()
            })
        end
    end

    table.sort(Remotes, function(a, b)
        return a.Path:lower() < b.Path:lower()
    end)

    scanning = false
end

-- BUILD COPY CODE
local function BuildCode(info)
    local obj = info.Object

    if not obj or not obj:IsDescendantOf(ReplicatedStorage) then
        return nil
    end

    -- Build path from the actual instance hierarchy.
    local parts = {}
    local current = obj

    while current and current ~= ReplicatedStorage do
        table.insert(parts, 1, current.Name)
        current = current.Parent
    end

    local code = 'local Event = game:GetService("ReplicatedStorage")'

    for _, part in ipairs(parts) do
        -- Escape quotes and backslashes in instance names.
        local escaped = part:gsub("\\", "\\\\"):gsub('"', '\\"')
        code ..= ':FindFirstChild("' .. escaped .. '")'
    end

    if info.Type == "RemoteEvent" then
        code ..= '\n\nEvent:FireServer(\n    false,\n    false\n)'
    else
        code = code:gsub("local Event =", "local Event =")
        code ..= '\n\n-- RemoteFunction: check the expected arguments before InvokeServer.'
    end

    return code
end

-- RENDER LIST
local function Render()
    for _, child in ipairs(List:GetChildren()) do
        if child ~= Layout and not child:IsA("UIPadding") then
            child:Destroy()
        end
    end

    local query = Search.Text:lower()
    local shown = 0

    for _, info in ipairs(Remotes) do
        local matches =
            info.Name:lower():find(query, 1, true)
            or info.Path:lower():find(query, 1, true)
            or info.Type:lower():find(query, 1, true)

        if matches and info.Object.Parent then
            shown += 1

            local Row = Create("Frame", {
                Name = "RemoteRow",
                Size = UDim2.new(1, -2, 0, 76),
                BackgroundColor3 = Theme.Background,
                BorderSizePixel = 0,
                LayoutOrder = shown
            }, List)

            Corner(Row, 8)

            local TypeColor = info.Type == "RemoteEvent"
                and Theme.Purple
                or Theme.Blue

            Create("Frame", {
                Position = UDim2.new(0, 5, 0, 8),
                Size = UDim2.new(0, 3, 0, 60),
                BackgroundColor3 = TypeColor,
                BorderSizePixel = 0
            }, Row)

            Create("TextLabel", {
                Position = UDim2.new(0, 15, 0, 5),
                Size = UDim2.new(1, -115, 0, 22),
                BackgroundTransparency = 1,
                Text = info.Name,
                TextColor3 = Theme.Text,
                TextSize = 12,
                Font = Enum.Font.GothamBold,
                TextXAlignment = Enum.TextXAlignment.Left,
                TextTruncate = Enum.TextTruncate.AtEnd
            }, Row)

            Create("TextLabel", {
                Position = UDim2.new(0, 15, 0, 28),
                Size = UDim2.new(1, -22, 0, 35),
                BackgroundTransparency = 1,
                Text = info.Type .. "\n" .. info.Path,
                TextColor3 = Theme.SubText,
                TextSize = 9,
                Font = Enum.Font.Gotham,
                TextXAlignment = Enum.TextXAlignment.Left,
                TextYAlignment = Enum.TextYAlignment.Top,
                TextWrapped = false,
                TextTruncate = Enum.TextTruncate.AtEnd
            }, Row)

            local Copy = Create("TextButton", {
                Position = UDim2.new(1, -91, 0, 8),
                Size = UDim2.new(0, 82, 0, 28),
                BackgroundColor3 = Theme.PurpleDark,
                Text = "COPY CODE",
                TextColor3 = Theme.Text,
                TextSize = 10,
                Font = Enum.Font.GothamBold,
                BorderSizePixel = 0
            }, Row)

            Corner(Copy, 6)

            Copy.MouseButton1Click:Connect(function()
                local code = BuildCode(info)

                if not code then
                    Status.Text = "Remote no longer exists"
                    return
                end

                if typeof(setclipboard) == "function" then
                    local ok = pcall(setclipboard, code)

                    if ok then
                        Status.Text = "Copied: " .. info.Name
                        Status.TextColor3 = Color3.fromRGB(120, 230, 160)
                    else
                        Status.Text = "Clipboard unavailable"
                        Status.TextColor3 = Theme.SubText
                    end
                else
                    Status.Text = "Clipboard unavailable in this environment"
                    Status.TextColor3 = Theme.SubText
                end
            end)
        end
    end

    Status.Text = string.format(
        "%d remotes found | %d shown",
        #Remotes,
        shown
    )

    Status.TextColor3 = Theme.SubText
end

Search:GetPropertyChangedSignal("Text"):Connect(Render)

Refresh.MouseButton1Click:Connect(function()
    Scan()
    Render()
end)

