-- SCAN REPLICATEDSTORAGE
local Remotes = {}
local scanning = false

local function Scan()
    if scanning or destroyed then
        return false
    end

    scanning = true
    local found = {}

    local ok, err = pcall(function()
        for _, obj in ipairs(ReplicatedStorage:GetDescendants()) do
            if obj:IsA("RemoteEvent")
                or obj:IsA("RemoteFunction") then

                table.insert(found, {
                    Object = obj,
                    Name = obj.Name,
                    Type = obj.ClassName
                })
            end
        end
    end)

    scanning = false

    if not ok then
        Status.Text = "Scan failed"
        warn(err)
        return false
    end

    table.sort(found, function(a, b)
        return a.Object:GetFullName():lower()
            < b.Object:GetFullName():lower()
    end)

    Remotes = found
    return true
end

-- BUILD REAL DOT PATH WHEN VALID
local function BuildPath(obj)
    local parts = {}
    local current = obj

    while current and current ~= ReplicatedStorage do
        table.insert(parts, 1, current.Name)
        current = current.Parent
    end

    local path = 'game:GetService("ReplicatedStorage")'

    for _, name in ipairs(parts) do
        if name:match("^[%a_][%w_]*$") then
            path ..= "." .. name
        else
            local escaped = name:gsub("\\", "\\\\")
                :gsub('"', '\\"')
            path ..= ':WaitForChild("' .. escaped .. '")'
        end
    end

    return path
end

local function BuildCode(info)
    if not info.Object
        or not info.Object:IsDescendantOf(ReplicatedStorage) then
        return nil
    end

    local path = BuildPath(info.Object)
    local variable = info.Type == "RemoteEvent" and "Event" or "Remote"

    local code = "local " .. variable .. " = " .. path

    if info.Type == "RemoteEvent" then
        code ..= "\n\n-- Replace sample arguments with the documented arguments.\n"
        code ..= "Event:FireServer(false, false)"
    else
        code ..= "\n\n-- Check expected arguments before InvokeServer."
    end

    return code
end

-- RENDER
local function Render()
    if destroyed or not Gui.Parent then
        return
    end

    for _, child in ipairs(List:GetChildren()) do
        if child ~= Layout and not child:IsA("UIPadding") then
            child:Destroy()
        end
    end

    local query = Search.Text:lower()
    local shown = 0

    for _, info in ipairs(Remotes) do
        local obj = info.Object

        if obj and obj:IsDescendantOf(ReplicatedStorage) then
            local path = BuildPath(obj)

            local matches =
                info.Name:lower():find(query, 1, true)
                or path:lower():find(query, 1, true)
                or info.Type:lower():find(query, 1, true)

            if matches then
                shown += 1

                local Row = Create("Frame", {
                    Name = "RemoteRow",
                    Size = UDim2.new(1, -2, 0, 78),
                    BackgroundColor3 = Theme.Row,
                    BorderSizePixel = 0,
                    LayoutOrder = shown
                }, List)
                Corner(Row, 7)

                Create("TextLabel", {
                    Position = UDim2.new(0, 10, 0, 5),
                    Size = UDim2.new(1, -108, 0, 23),
                    BackgroundTransparency = 1,
                    Text = info.Name,
                    TextColor3 = Theme.Text,
                    TextSize = 12,
                    Font = Enum.Font.GothamBold,
                    TextXAlignment = Enum.TextXAlignment.Left,
                    TextTruncate = Enum.TextTruncate.AtEnd
                }, Row)

                Create("TextLabel", {
                    Position = UDim2.new(0, 10, 0, 29),
                    Size = UDim2.new(1, -18, 0, 39),
                    BackgroundTransparency = 1,
                    Text = info.Type .. "\n" .. path,
                    TextColor3 = Theme.SubText,
                    TextSize = 9,
                    Font = Enum.Font.Gotham,
                    TextXAlignment = Enum.TextXAlignment.Left,
                    TextYAlignment = Enum.TextYAlignment.Top,
                    TextWrapped = false,
                    TextTruncate = Enum.TextTruncate.AtEnd
                }, Row)

                local Copy = Create("TextButton", {
                    Position = UDim2.new(1, -94, 0, 7),
                    Size = UDim2.new(0, 86, 0, 28),
                    BackgroundColor3 = Theme.Button,
                    Text = "COPY CODE",
                    TextColor3 = Theme.Text,
                    TextSize = 10,
                    Font = Enum.Font.GothamBold,
                    BorderSizePixel = 0
                }, Row)
                Corner(Copy, 6)
                Stroke(Copy, Theme.Border)

                Copy.MouseButton1Click:Connect(function()
                    local code = BuildCode(info)

                    if not code then
                        Status.Text = "Remote no longer exists"
                        Status.TextColor3 = Theme.Red
                        return
                    end

                    if typeof(setclipboard) ~= "function" then
                        Status.Text = "Clipboard unsupported by executor"
                        Status.TextColor3 = Theme.Red
                        return
                    end

                    local success, copyError = pcall(function()
                        setclipboard(code)
                    end)

                    if success then
                        Status.Text = "Copy attempted: " .. info.Name
                        Status.TextColor3 = Theme.Green
                    else
                        Status.Text = "Clipboard failed"
                        Status.TextColor3 = Theme.Red
                        warn(copyError)
                    end
                end)
            end
        end
    end

    Status.Text = string.format(
        "%d remotes found | %d shown",
        #Remotes,
        shown
    )
    Status.TextColor3 = Theme.SubText
end

